<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.18.0" />
    <!--
      NSign.Client and NSign.BouncyCastle remain pinned as a study reference
      for the Phase 2 hand-rolled verifier and as the canonical source of the
      BouncyCastle Ed25519 transitive. They are *not* wired into the runtime
      pipeline; AAuth's signer (Phase 1) and verifier (Phase 2) are direct
      implementations of the small fixed AAuth covered-component set.
      See `.agent/plans/2026-05-13-dotnet-aauth-sdk/implementation-plan.md`
      §"Phase 1/2 Implementation Decisions" for the full rationale.
    -->
    <PackageReference Include="NSign.BouncyCastle" Version="1.2.3" />
    <PackageReference Include="NSign.Client" Version="1.2.3" />
  </ItemGroup>

  <!--
    Phase 2 introduces ASP.NET Core server-side middleware, well-known
    endpoint mappers, and minimal-API endpoint extensions. These types
    require the ASP.NET Core shared framework. Per the single-library
    decision in the plan, they ship inside `AAuth.csproj` rather than a
    separate `AAuth.AspNetCore` package. Non-web consumers will still
    resolve the shared framework but won't load it at runtime unless they
    instantiate the server types.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
