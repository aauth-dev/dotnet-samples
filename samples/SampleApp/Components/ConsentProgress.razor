<ol class="consent-progress" aria-label="Consent state" data-consent-stage="decision-pending">
    <li>Authorization request verified</li>
    <li aria-current="step">Authenticated decision pending (agent already polling)</li>
    <li>Owner-bound delivery pending</li>
</ol>
<details>
    <summary>Browser and pending exchange</summary>
    @* highlight.js rewrites the code element, so re-create it rather than diff inside it. *@
    <pre @key="Exchange"><code class="language-http">@Exchange</code></pre>
</details>

<style>
    .consent-progress { display: flex; flex-wrap: wrap; gap: 1rem 2rem; padding: 0 0 0 1.25rem; }
    .consent-progress li { padding-right: 1rem; }
    .consent-progress [aria-current] { font-weight: 600; }
</style>

@code {
    [Parameter] public string ConsentPath { get; set; } = "/interaction";
    [Parameter] public string DecisionPath { get; set; } = "/interaction";

    /// <summary>Whether the Person Server dashboard can decide this request.</summary>
    [Parameter] public bool Dashboard { get; set; } = true;

    private string Exchange =>
        (Dashboard
            ? "Dashboard (all your pending requests):\n"
              + "GET /dashboard?code=...          sign in; this request is highlighted\n"
              + "POST /dashboard/requests/{id}/approve\n"
              + "X-CSRF-Token: ...\n\n"
              + "Or this one request:\n"
            : "")
        + $"GET {ConsentPath}?code=...\n"
        + "Sign in with the configured identity\n"
        + $"302 Location: {ConsentPath}?session=...\n"
        + $"POST {DecisionPath}/approve\n"
        + "Content-Type: application/x-www-form-urlencoded\n\n"
        + "session=...&csrf=...\n\n"
        + "GET /pending/... (signed by the original owner and key, polled from the start)\n"
        + "200 (one delivery), 403 (denied), or 408 (expired)\n"
        + "Subsequent polls: 410 Gone";
}