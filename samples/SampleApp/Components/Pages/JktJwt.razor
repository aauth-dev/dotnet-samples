@page "/anchored"
@using AAuth.Agent
@using AAuth.Crypto
@using AAuth.HttpSig
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>JKT-JWT — Key Rotation</PageTitle>

<h2>JKT-JWT — Key Rotation (Two-Key Refresh)</h2>

<p>
    Key rotation without re-enrolment. The enrolled <strong>durable key</strong> signs a
    naming JWT that binds a fresh <strong>ephemeral key</strong>. The ephemeral key signs
    HTTP requests. When the ephemeral key needs rotating, the agent builds a new
    naming JWT — the AP never needs to re-enrol the agent.
</p>

<div class="row">
<div class="col-md-6">
<h5>Client Code</h5>
<pre><code class="language-csharp">// Two-key refresh: get ephemeral key from AP
var result = await apClient.RefreshTwoKeyAsync(
    refreshEndpoint, localKeyHandle, apIssuer);

// Durable key signs naming JWT binding ephemeral key
var namingJwt = NamingJwtBuilder.Build(
    durableKey, result.EphemeralKey,
    apIssuer, durableKey.ComputeJwkThumbprint());

// Ephemeral key signs HTTP requests
using var client = new AAuthClientBuilder(result.EphemeralKey)
    .UseJktJwt(() => namingJwt)
    .Build();</code></pre>
</div>
<div class="col-md-6">
<h5>How It Works</h5>
<p class="fw-bold small text-secondary mb-1">Setup (agent ↔ AP)</p>
<ol>
    <li>Agent generates a new <strong>ephemeral</strong> Ed25519 key</li>
    <li>Agent builds a <strong>naming JWT</strong> signed by the durable key,
        embedding the ephemeral key as <code>cnf.jwk</code></li>
    <li>Agent sends refresh POST to AP signed with the ephemeral key,
        including the naming JWT in the <code>Signature-Key</code> header</li>
    <li>AP verifies naming JWT signature against enrolled durable key,
        verifies HTTP sig against ephemeral key</li>
</ol>
<p class="fw-bold small text-secondary mb-1">Resource access (2-party, no AP)</p>
<ol start="5">
    <li>Agent signs resource requests with ephemeral key + naming JWT
        (<code>sig=jkt-jwt</code>). Resource verifies the HTTP signature
        against <code>cnf.jwk</code> and identifies the agent by
        the durable key's <code>jkt</code> thumbprint.</li>
</ol>
</div>
</div>

@if (!_enrolled)
{
    <button class="btn btn-outline-secondary" @onclick="Enrol" disabled="@_loading">
        @(_loading ? "Enrolling..." : "1. Enrol with Agent Provider")
    </button>
}
else
{
    <div class="alert alert-info">
        Enrolled. Local key handle: <code>@_enrollment!.LocalKeyHandle</code><br/>
        Durable key thumbprint: <code>@_durableThumbprint</code>
    </div>

    @if (_ephemeralThumbprint is null)
    {
        <button class="btn btn-outline-secondary" @onclick="TwoKeyRefresh" disabled="@_loading">
            @(_loading ? "Refreshing..." : "2. Two-Key Refresh (generate ephemeral key)")
        </button>
    }
    else
    {
        <div class="alert alert-success">
            Ephemeral key: <code>@_ephemeralThumbprint</code><br/>
            <small class="text-muted">
                This key signed the refresh request and will sign resource requests.
                The durable key never leaves the agent — it only signs naming JWTs.
            </small>
        </div>

        <button class="btn btn-primary" @onclick="SendRequest" disabled="@_loading">
            @(_loading ? "Sending..." : "3. Send Signed Request to Resource")
        </button>
    }
}

@if (_response is not null)
{
    <div class="mt-3">
        <h5>Response</h5>
        <div class="alert @(_success ? "alert-success" : "alert-warning")">
            <strong>@_statusCode</strong>
        </div>
        <pre><code class="language-json">@_response</code></pre>
    </div>
}

@if (_error is not null)
{
    <div class="mt-3 alert alert-danger">@_error</div>
}

@code {
    [Inject] private EnrollmentService _enrollment { get; set; } = default!;
    [Inject] private IConfiguration Config { get; set; } = default!;

    private bool _loading;
    private bool _enrolled;
    private string? _durableThumbprint;
    private string? _ephemeralThumbprint;
    private IAAuthKey? _ephemeralKey;
    private string? _namingJwt;
    private string? _response;
    private string? _error;
    private string? _statusCode;
    private bool _success;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("highlightCode");
    }

    protected override void OnInitialized()
    {
        _enrolled = _enrollment.IsEnrolled;
        if (_enrolled)
            _durableThumbprint = _enrollment.Key.ComputeJwkThumbprint();
    }

    private async Task Enrol()
    {
        _loading = true;
        _error = null;
        try
        {
            await _enrollment.EnsureEnrolledAsync();
            _enrolled = true;
            _durableThumbprint = _enrollment.Key.ComputeJwkThumbprint();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task TwoKeyRefresh()
    {
        _loading = true;
        _error = null;
        try
        {
            var apBase = Config["AAuth:AgentProvider"]!;
            var apClient = new AgentProviderClient(new HttpClient(), _enrollment.KeyStore);

            // Spec: two-key refresh generates an ephemeral key, builds a naming JWT
            // signed by the durable key, and sends the refresh signed by the ephemeral key.
            var result = await apClient.RefreshTwoKeyAsync(
                _enrollment.RefreshEndpoint, _enrollment.LocalKeyHandle, apBase.TrimEnd('/'));

            _ephemeralKey = result.EphemeralKey;
            _ephemeralThumbprint = ((AAuthKey)_ephemeralKey).ComputeJwkThumbprint();

            // Build the naming JWT for resource requests.
            // The durable key signs it, binding the ephemeral key via cnf.jwk.
            _namingJwt = NamingJwtBuilder.Build(
                _enrollment.Key, _ephemeralKey, apBase.TrimEnd('/'), _durableThumbprint!);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SendRequest()
    {
        _loading = true;
        _response = null;
        _error = null;

        try
        {
            // Ephemeral key signs the HTTP request; naming JWT proves delegation from durable key.
            var namingJwt = _namingJwt!;
            using var client = new AAuthClientBuilder(_ephemeralKey!)
                .UseJktJwt(() => namingJwt)
                .Build();

            var resourceUrl = Config["AAuth:Profile"]!;
            var response = await client.GetAsync(resourceUrl.TrimEnd('/') + "/anchored");

            _statusCode = $"{(int)response.StatusCode} {response.ReasonPhrase}";
            _success = response.IsSuccessStatusCode;
            var raw = await response.Content.ReadAsStringAsync();
            try
            {
                _response = System.Text.Json.JsonSerializer.Serialize(
                    System.Text.Json.JsonDocument.Parse(raw),
                    new System.Text.Json.JsonSerializerOptions
                    {
                        WriteIndented = true,
                        Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
                    });
            }
            catch { _response = raw; }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
