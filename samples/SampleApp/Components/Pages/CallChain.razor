@page "/call-chain"
@using AAuth.Crypto
@using AAuth.HttpSig
@using AAuth.Tokens
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Call Chain — Multi-Agent</PageTitle>

<h2>Call Chain — Multi-Agent Delegation</h2>

<p>
    Demonstrates multi-hop call chaining: <strong>Agent&nbsp;A</strong> (this app) calls
    the <strong>Orchestrator</strong> (an intermediate service), which then calls the
    <strong>WhoAmI</strong> resource. Each hop carries its own AAuth identity. The final
    response shows all three participants in the chain.
</p>

<div class="row">
<div class="col-md-6">
<h5>Agent (Client) Code</h5>
<pre><code class="language-csharp">// Agent A builds a signed client with challenge
// handling — the SDK automatically:
//   1. Sends agent token → gets 401 + resource_token
//   2. Exchanges at PS → gets auth token
//   3. Retries with auth token
using var client = new AAuthClientBuilder(key)
    .WithTokenRefresh(async (ctx, ct) =&gt;
    {
        var ap = new AgentProviderClient(
            new HttpClient(), keyStore);
        return await ap.RefreshAsync(
            refreshEndpoint, localKeyHandle, ct);
    })
    .WithChallengeHandling(personServer)
    .Build();

// Calls the Orchestrator (not WhoAmI directly).
// The challenge is handled transparently.
var response = await client.GetAsync(
    orchestratorUrl);</code></pre>
</div>
<div class="col-md-6">
<h5>Orchestrator (Server) Setup</h5>
<pre><code class="language-csharp">// The Orchestrator is BOTH a resource AND an agent.
// DI setup:
builder.Services.AddSingleton(new TokenVerifier());
builder.Services.AddSingleton&lt;MetadataClient&gt;(...);
builder.Services.AddSingleton&lt;JwksClient&gt;(...);

// Full issuer verification — validates JWT signatures
// via JWKS discovery for both agent and auth tokens.
app.UseAAuthVerification(new AAuthVerificationOptions
{
    ResourceIdentifier = orchestratorUrl,
    RequireIssuerVerification = true,
});</code></pre>
<h5 class="mt-3">Orchestrator Handler</h5>
<pre><code class="language-csharp">app.MapGet("/", async (HttpContext ctx) =&gt;
{
    var parsed = (ParsedSignatureKeyInfo)
        ctx.Items[ParsedInfoItemKey]!;
    var typ = (string?)parsed.Header?["typ"];

    // Agent token → challenge (like any resource)
    if (typ == "aa-agent+jwt")
    {
        var rt = new ResourceTokenBuilder { ... };
        ctx.Response.Headers["AAuth-Requirement"]
            = FormatAuthToken(rt.Build());
        return Results.Unauthorized();
    }

    // Auth token → call downstream with chaining.
    // WithCallChaining reads the upstream token from
    // the verified auth token automatically.
    using var client = new AAuthClientBuilder(key)
        .WithTokenRefresh(refreshFunc)
        .WithCallChaining(ctx) // upstream_token + mission
        .Build();
    var result = await client.GetAsync(downstreamUrl);
    return Results.Content(
        await result.Content.ReadAsStringAsync(),
        "application/json");
});</code></pre>
</div>
</div>

<div class="alert alert-info">
    Self-issued agent identity. Key ID: <code>@_identity.KeyId</code>
</div>

<button class="btn btn-primary" @onclick="SendChainedRequest" disabled="@_loading">
    @(_loading ? "Sending..." : "Send Chained Request (Agent → Orchestrator → WhoAmI)")
</button>

@if (_response is not null)
{
    <div class="mt-3">
        <h5>Response (shows full chain)</h5>
        <div class="alert @(_success ? "alert-success" : "alert-warning")">
            <strong>@_statusCode</strong>
        </div>
        <pre><code class="language-json">@_response</code></pre>
    </div>
}

@if (_error is not null)
{
    <div class="mt-3 alert alert-danger">@_error</div>
}

@code {
    [Inject] private SelfIssuedIdentity _identity { get; set; } = default!;
    [Inject] private IConfiguration Config { get; set; } = default!;

    private bool _loading;
    private string? _response;
    private string? _error;
    private string? _statusCode;
    private bool _success;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("highlightCode");
    }

    private async Task SendChainedRequest()
    {
        _loading = true;
        _response = null;
        _error = null;

        try
        {
            var personServer = Config["AAuth:PersonServer"]!;
            var orchestratorUrl = Config["AAuth:Orchestrator"]!;

            // Pre-grant consent so the PS issues tokens immediately
            await GrantConsentAsync(orchestratorUrl);

            // Self-issued token refresh — no AP round-trip needed
            using var client = new AAuthClientBuilder(_identity.Key)
                .WithTokenRefresh(async (ctx, ct) =>
                {
                    return new AgentTokenBuilder
                    {
                        Issuer = _identity.Issuer,
                        Subject = _identity.AgentId,
                        KeyId = _identity.KeyId,
                        Key = _identity.Key,
                        PersonServer = personServer,
                    }.Build();
                })
                .WithChallengeHandling(personServer)
                .Build();

            var response = await client.GetAsync(orchestratorUrl);

            _statusCode = $"{(int)response.StatusCode} {response.ReasonPhrase}";
            _success = response.IsSuccessStatusCode;
            var raw = await response.Content.ReadAsStringAsync();
            try { _response = System.Text.Json.JsonSerializer.Serialize(System.Text.Json.JsonDocument.Parse(raw), new System.Text.Json.JsonSerializerOptions { WriteIndented = true, Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping }); }
            catch { _response = raw; }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task GrantConsentAsync(string resource)
    {
        var personServer = Config["AAuth:PersonServer"];
        if (string.IsNullOrEmpty(personServer)) return;

        var agentId = _identity.AgentId;

        using var http = new HttpClient();
        try
        {
            await http.PostAsJsonAsync(
                $"{personServer.TrimEnd('/')}/admin/consent",
                new { agent = agentId, resource = resource.TrimEnd('/') });
        }
        catch
        {
            // /admin/consent only exists on MockPersonServer — swallow
        }
    }
}
