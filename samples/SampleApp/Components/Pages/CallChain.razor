@page "/call-chain"
@using AAuth.Agent
@using AAuth.Crypto
@using AAuth.Headers
@using AAuth.HttpSig
@implements IAAuthInteractionHandler
@inject IJSRuntime JS
@inject SampleAgents Agents
@rendermode InteractiveServer

<PageTitle>Call Chain — Multi-Agent</PageTitle>

<h2>Call Chain — Multi-Agent Delegation</h2>

<details class="alert alert-primary aria-narrative" open>
    <summary>📖 What Aria is trying to do</summary>
    Aria (your AI travel assistant) doesn't read your
    <strong>Calendar</strong> directly — it delegates the planning to an
    <strong>Concierge</strong> service, which reads the Calendar on Aria's behalf. You
    consent once for Aria to use the Concierge, and again for the Concierge to reach
    your Calendar, so the final resource sees the full delegation path.
</details>

<p>
    Demonstrates multi-hop call chaining with genuine <strong>interaction chaining</strong>:
    <strong>Agent&nbsp;A</strong> (this app) calls the <strong>Concierge</strong> (an
    intermediate service), which then calls the <strong>Calendar</strong> resource. Each hop
    requires the user's consent at the Person Server:
</p>
<ul>
    <li><strong>Hop&nbsp;1</strong> (Agent&nbsp;A → Concierge, scope <code>concierge</code>):
        plain <em>Interaction Required</em> — Agent&nbsp;A relays you to the PS consent page.</li>
    <li><strong>Hop&nbsp;2</strong> (Concierge → Calendar, scope <code>calendar.read</code>):
        the Concierge has no user, so it re-emits its <em>own</em> <code>202</code>
        (AAuth §Interaction Chaining). Agent&nbsp;A relays you to the Concierge
        interaction URL, which redirects to the Person Server consent page, then
        receives the final chained result. Each intermediary issues its <em>own</em>
        interaction code and poll URL.</li>
</ul>

<p class="text-muted">
    <small>
        <strong>Note:</strong> mission-based <strong>agent governance</strong> is
        optional and orthogonal to call chaining (AAuth §Agent Governance) and is
        intentionally left out of this demo, so the upstream token carries no
        <code>mission_s256</code>. Each hop routes its downstream token requests to
        the Person Server the upstream token names: the <code>iss</code> of a person
        token, or the <code>ps</code> of an auth token, even when an Access Server
        issued it (§Call Chaining). A <code>mission_s256</code> in the upstream token
        would travel on in the downstream person and auth tokens. The intermediary
        signs with its own agent token and sends <code>upstream_token</code> in the
        body. Cached downstream grants are
        reused only for the same upstream authorization, mission, account and key.
    </small>
</p>

<div class="row">
<div class="col-md-6">
<h5>Agent (Client) Code</h5>
<pre><code class="language-csharp">// Agent A is Aria, registered with AddAAuthAgent. Its
// consent handler sees BOTH hops: hop 1 (the PS exchange
// 202, interaction.Source == PersonServer) and hop 2 (the
// Concierge's CHAINED resource 202, Source == Resource).
// Each surfaces interaction.BuildUserUrl() to the user.
var client = clients.CreateClient("aria");

// Calls the Concierge (not Calendar directly).
using var request = new HttpRequestMessage(HttpMethod.Get, conciergeUrl);
request.Options.Set(AAuthRequestOptions.InteractionHandler, consent);
var response = await client.SendAsync(request);</code></pre>
</div>
<div class="col-md-6">
<h5>Concierge Handler (interaction chaining)</h5>
<pre><code class="language-csharp">// The Concierge is BOTH a resource AND an agent,
// but has NO user — so its downstream client CHAINS
// the interaction instead of relaying it: the callback
// THROWS, unwinding the exchange before it blocks.
async Task&lt;IResult&gt; RunChainAsync(HttpContext ctx, string upstream)
{
    using var downstream = AAuthClientBuilder
        .SelfIssuing(conciergeKey)
        .As(conciergeUrl, agentId)
        .WithKid(kid)
        .WithPersonServer(psUrl)
        .WithCallChaining(upstream)   // sends upstream_token to the PS it
                                      // names (a mission_s256 would travel
                                      // on; omitted here)
        .WithChallengeHandling(opts =&gt;
        {
            opts.OnInteractionRequired = (i, _) =&gt;
                throw new AAuthInteractionChainedException(i);
            opts.Capabilities = Array.Empty&lt;string&gt;();
        })
        .Build();

    var r = await downstream.GetAsync($"{calendarUrl}/events");
    return Results.Ok(/* combined chain result */);
}

app.MapGet("/", async (HttpContext ctx, PendingStore pending) =&gt;
{
    var upstream = ctx.Features
        .Get&lt;UpstreamAuthTokenFeature&gt;()!.Token;
    try
    {
        return await RunChainAsync(ctx, upstream);
    }
    catch (AAuthInteractionChainedException ex)
    {
        // Downstream needs consent. Park it and
        // re-emit our OWN code, URL and poll Location.
        var chained = AAuthChainedInteractions.Park(
            conciergeUrl, "/pending", "/chain-interaction", ex,
            "calendar.events", new JsonObject(), DateTimeOffset.UtcNow.AddMinutes(10));
        var e = pending.Add(upstream, chained);
        return ReEmitChainedInteraction(ctx, e);
    }
});</code></pre>
</div>
</div>

<div class="alert alert-info">
    Self-issued agent identity. Key ID: <code>@_identity.KeyId</code>
</div>

@if (!_waitingForApproval && _response is null)
{
    <button class="btn btn-primary" @onclick="SendChainedRequest" disabled="@_loading">
        @(_loading ? "Sending..." : "Send Chained Request (Agent → Concierge → Calendar)")
    </button>
    <p class="text-muted mt-1">
        <small>
            <strong>Heads up:</strong> this chain needs <strong>two</strong> separate approvals —
            you will be asked to click <strong>Approve</strong> <strong>twice</strong>, once per hop.
        </small>
    </p>
}

@if (_waitingForApproval && _interaction is not null)
{
    @* Hop 1 = blue (primary), Hop 2 = purple-ish (info) so the two distinct
       approvals are visually obvious. *@
    <div class="mt-3 alert @(_currentHopNumber == 1 ? "alert-primary" : "alert-info")">
        <h5>
            <span class="badge @(_currentHopNumber == 1 ? "bg-primary" : "bg-info") me-2">
                Approval @_currentHopNumber of 2
            </span>
            @_currentHop
        </h5>
        <p>A <code>202 Accepted</code> was returned and the SDK is already polling for your decision.</p>
        @* Hop 2's URL is the Concierge's relay, which redirects to the PS consent page. *@
        <PersonServerApprovalPrompt PersonServer="@Agents.PersonServer" Interaction="_interaction!" PollCount="_pollCount"
                                    DecidedAtPersonServer="true"
                                    Lead="@(_currentHopNumber == 1
                                        ? $"Approval {_currentHopNumber} of 2. Decide it on your Person Server; a second approval (hop 2) follows."
                                        : $"Approval {_currentHopNumber} of 2, the last one. The chain completes after it.")" />
    </div>
}

@if (_approvedHops.Count > 0)
{
    <div class="mt-2">
        <small class="text-muted">Approved: @string.Join(", ", _approvedHops)</small>
    </div>
}

@if (_response is not null)
{
    <div class="mt-3">
        <h5>Response (shows full chain)</h5>
        <div class="alert @(_success ? "alert-success" : "alert-warning")">
            <strong>@_statusCode</strong>
        </div>
        <pre><code class="language-json">@_response</code></pre>
    </div>
}

@if (_error is not null)
{
    <div class="mt-3 alert alert-danger">@_error</div>
}

@code {
    [Inject] private SelfIssuedIdentity _identity { get; set; } = default!;
    [Inject] private IConfiguration Config { get; set; } = default!;

    private bool _loading;
    private bool _waitingForApproval;
    private AAuth.Headers.Interaction? _interaction;
    private string? _currentHop;
    private int _currentHopNumber;
    private int _hopIndex;
    private readonly List<string> _approvedHops = new();
    private int _pollCount;
    private string? _response;
    private string? _error;
    private string? _statusCode;
    private bool _success;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("highlightCode");
    }

    private async Task SendChainedRequest()
    {
        _loading = true;
        _response = null;
        _error = null;
        _waitingForApproval = false;
        _interaction = null;
        _currentHop = null;
        _currentHopNumber = 0;
        _hopIndex = 0;
        _approvedHops.Clear();
        _pollCount = 0;

        try
        {
            var personServer = Agents.PersonServer;
            var conciergeUrl = Config["AAuth:Concierge"]!;

            // Demo: start from no grant so hop 1 prompts every run.
            Agents.StartOver();

            // Reset the PS consent store so BOTH hops always surface their own
            // approval. The hop-2 consent — (Concierge, Calendar, calendar.read) —
            // is keyed by the Concierge's identity, independent of which agent
            // started the chain, so a prior run (or the Guided Tour's call-chain
            // flow) that already approved it would otherwise silently skip hop 2.
            // Mirrors the Guided Tour's per-flow reset. /admin/* is MockPersonServer-only.
            try
            {
                using var resetClient = new System.Net.Http.HttpClient();
                await resetClient.PostAsync($"{personServer.TrimEnd('/')}/admin/reset", null);
            }
            catch { /* swallow — the admin reset endpoint is demo-only */ }

            // Background timer to update the poll count in the UI.
            using var pollTimer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            var pollTask = Task.Run(async () =>
            {
                while (await pollTimer.WaitForNextTickAsync())
                {
                    _pollCount++;
                    await InvokeAsync(StateHasChanged);
                }
            });

            // Hop 1 (the PS exchange 202) and hop 2 (the Concierge's chained 202)
            // both reach OnInteractionRequiredAsync; the SDK then polls and resumes.
            using var request = new HttpRequestMessage(HttpMethod.Get, conciergeUrl);
            request.Options.Set(AAuthRequestOptions.InteractionHandler, this);
            var response = await Agents.AriaClient.SendAsync(request);

            pollTimer.Dispose();

            if (_currentHop is not null)
            {
                _approvedHops.Add(_currentHop);
                _currentHop = null;
            }
            _waitingForApproval = false;
            _statusCode = $"{(int)response.StatusCode} {response.ReasonPhrase}";
            _success = response.IsSuccessStatusCode;
            var raw = await response.Content.ReadAsStringAsync();
            try { _response = System.Text.Json.JsonSerializer.Serialize(System.Text.Json.JsonDocument.Parse(raw), new System.Text.Json.JsonSerializerOptions { WriteIndented = true, Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping }); }
            catch { _response = raw; }
        }
        catch (AAuthInteractionDeniedException)
        {
            _waitingForApproval = false;
            _error = "The user denied the consent request.";
        }
        catch (AAuthInteractionTimeoutException)
        {
            _waitingForApproval = false;
            _error = "Timed out waiting for user approval (polling budget expired).";
        }
        catch (Exception ex)
        {
            _waitingForApproval = false;
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    // Hop 1 comes from the PS exchange; hop 2 is the Concierge's chained resource 202,
    // whose URL is owned by the Concierge and redirects to the PS consent page.
    public async Task OnInteractionRequiredAsync(AAuth.Headers.Interaction interaction, CancellationToken cancellationToken)
    {
        if (_currentHop is not null)
        {
            _approvedHops.Add(_currentHop);
        }
        _hopIndex++;
        _currentHopNumber = _hopIndex;
        _currentHop = _hopIndex == 1
            ? "Hop 1: Agent → Concierge (concierge)"
            : "Hop 2: Concierge → Calendar (calendar.read, chained)";
        _interaction = interaction;
        _waitingForApproval = true;
        await InvokeAsync(StateHasChanged);
    }
}
