@page "/inbox"
@using AAuth
@using AAuth.Crypto
@using AAuth.HttpSig
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Inbox — Resource-Managed</PageTitle>

<h2>Resource-Managed (Two-Party) Access</h2>

<details class="alert alert-primary aria-narrative" open>
    <summary>📖 What Aria is trying to do</summary>
    Aria wants to import your trip confirmations from your <strong>Inbox</strong>.
    The Inbox manages authorization <strong>itself</strong> — it has its own consent
    page, with no Person Server involved. After you approve, the Inbox hands Aria an
    opaque access token that Aria replays (bound to its signature) on later calls.
    This is the access mode that <em>drops in where you use OAuth</em>.
</details>

<p>
    Two parties only (agent + resource). The first call returns
    <code>202</code> with an interaction requirement pointing at the Inbox's own
    consent page; once you approve, the Inbox issues an <code>AAuth-Access</code>
    token that the SDK captures and replays as
    <code>Authorization: AAuth &lt;token68&gt;</code>.
</p>

<div class="row">
<div class="col-md-6">
<h5>Client Code</h5>
<pre><code class="language-csharp">var key = AAuthKey.Generate();

using var client = new AAuthClientBuilder(key)
    .UseHwk()
    .WithResourceManagedAccess()
    .WithInteractionHandling(o =&gt;
    {
        o.OnInteractionRequired = (url, code, ct) =&gt;
        {
            // Show the user the Inbox consent URL.
            return Task.CompletedTask;
        };
    })
    .Build();

// First call drives the 202 → consent → poll handshake.
await client.GetAsync($"{inbox}/messages");
// Subsequent calls replay Authorization: AAuth, bound to the signature.
var resp = await client.GetAsync($"{inbox}/messages");</code></pre>
</div>
<div class="col-md-6">
<h5>Server Code</h5>
<pre><code class="language-csharp">// Two-party (no PS/AS): verify the HTTP signature only — there is no
// auth-token issuer to verify.
app.UseAAuthVerification(AAuthVerificationOptions.SignatureOnly());

var store = app.Services.GetRequiredService&lt;IOpaqueTokenStore&gt;(); // mints/validates tokens
var pending = new PendingStore();   // sample-only: remembers approved consent codes

// Serve messages when a valid AAuth-Access token is presented; otherwise
// open a consent interaction.
app.MapGet("/messages", async (HttpContext ctx) =&gt;
{
    // ResolveAAuthAccessAsync token68-validates Authorization: AAuth,
    // confirms the signature covered it, and looks it up in the store.
    var info = await ctx.ResolveAAuthAccessAsync(store);
    if (info is not null)
        return Results.Ok(new { scope = info.Scope, messages });

    return await RequireConsent(ctx, "inbox.read");
});

// Opens a consent interaction at the Inbox's OWN page; `pending` records the
// code so the /pending poll can issue the AAuth-Access token once approved.
async Task&lt;IResult&gt; RequireConsent(HttpContext ctx, string scope)
{
    var code = NewInteractionCode();
    pending.Create(code, ctx.GetAAuthVerification()!.Jkt!, scope);
    return ctx.InteractionRequiredAAuth(
        $"{issuer}/consent", code, $"{issuer}/pending/{code}");
}</code></pre>
</div>
</div>

<button class="btn btn-primary" @onclick="SendRequest" disabled="@_loading">
    @(_loading ? "Waiting…" : "Read my inbox")
</button>

@if (_consentUrl is not null && _messages is null)
{
    <div class="mt-3 alert alert-info">
        <strong>The Inbox needs your approval.</strong>
        Open its consent page, click <em>Approve</em>, then return here —
        the SDK is polling and will continue automatically.
        <div class="mt-2">
            <a class="btn btn-success btn-sm" href="@_consentUrl" target="_blank" rel="noopener" id="consent-link">
                Approve at the Inbox →
            </a>
        </div>
    </div>
}

@if (_status is not null)
{
    <div class="mt-3">
        <h5>Response</h5>
        <div class="alert @(_success ? "alert-success" : "alert-warning")">
            <strong>@_status</strong>
        </div>
        @if (_messages is not null)
        {
            <pre><code class="language-json">@_messages</code></pre>
        }
    </div>
}

@if (_error is not null)
{
    <div class="mt-3 alert alert-danger">@_error</div>
}

@code {
    [Inject] private IConfiguration Config { get; set; } = default!;

    private bool _loading;
    private string? _consentUrl;
    private string? _messages;
    private string? _status;
    private bool _success;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("highlightCode");
    }

    private async Task SendRequest()
    {
        _loading = true;
        _consentUrl = null;
        _messages = null;
        _status = null;
        _error = null;

        try
        {
            var key = AAuthKey.Generate();
            var inbox = Config["AAuth:Inbox"]!.TrimEnd('/');

            using var client = new AAuthClientBuilder(key)
                .UseHwk()
                .WithResourceManagedAccess()
                .WithInteractionHandling(o =>
                {
                    o.OnInteractionRequired = async (url, code, ct) =>
                    {
                        // Surface the Inbox's own consent URL to the user, then
                        // keep polling until they approve.
                        _consentUrl = url;
                        await InvokeAsync(StateHasChanged);
                    };
                    o.DefaultPollInterval = TimeSpan.FromSeconds(1);
                })
                .Build();

            // 1. Drive the 202 → consent → poll handshake (blocks until approved).
            var first = await client.GetAsync($"{inbox}/messages");
            first.Dispose();

            // 2. Replay the captured token to read the inbox.
            var response = await client.GetAsync($"{inbox}/messages");
            _status = $"{(int)response.StatusCode} {response.ReasonPhrase}";
            _success = response.IsSuccessStatusCode;
            var raw = await response.Content.ReadAsStringAsync();
            try
            {
                _messages = System.Text.Json.JsonSerializer.Serialize(
                    System.Text.Json.JsonDocument.Parse(raw),
                    new System.Text.Json.JsonSerializerOptions
                    {
                        WriteIndented = true,
                        Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
                    });
            }
            catch { _messages = raw; }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
