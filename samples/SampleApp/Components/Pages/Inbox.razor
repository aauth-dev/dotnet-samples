@page "/inbox"
@using AAuth
@using AAuth.Crypto
@using AAuth.HttpSig
@using AAuth.Agent
@implements IAAuthInteractionHandler
@inject IJSRuntime JS
@inject EnrollmentService Enrollment
@rendermode InteractiveServer

<PageTitle>Inbox — Resource-Managed</PageTitle>

<h2>Resource-Managed (Two-Party) Access</h2>

<details class="alert alert-primary aria-narrative" open>
    <summary>📖 What Aria is trying to do</summary>
    Aria wants to import your trip confirmations from your <strong>Inbox</strong>.
    The Inbox manages authorization <strong>itself</strong> — it has its own consent
    page, with no Person Server involved. After you approve, the Inbox hands Aria an
    opaque access token that Aria replays (bound to its signature) on later calls.
    The resource is its own authorization server here — the role a <em>first-party
    OAuth</em> deployment plays.
</details>

<p>
    Authorization has two parties (agent + Inbox), with no PS/AS token exchange.
    On first use, SampleApp separately enrolls its persisted durable key with the
    Agent Provider using a signed request. It retains the local key handle and
    obtains an <code>aa-agent+jwt</code> from the AP's signed refresh endpoint
    before calling the Inbox. The first resource call returns
    <code>202</code> with an interaction requirement pointing at the Inbox's own
    consent page; once you approve, the Inbox issues an <code>AAuth-Access</code>
    token that the SDK captures and replays as
    <code>Authorization: AAuth &lt;token68&gt;</code>.
</p>

<div class="row">
<div class="col-md-6">
<h5>Client Code</h5>
<pre><code class="language-csharp">// The injected EnrollmentService discovers AP metadata, signs enrollment
// with a persisted durable key, and retains the key handle and refresh URL.
await Enrollment.EnsureEnrolledAsync();

// Once enrolled, it creates ONE agent for that identity and keeps it as
// Enrollment.Agent (disposed with the service):
var agent = factory.Create(new AAuthAgentDescriptor("sample-app-enrolled")
{
    EgressPolicy = SampleEgress.Policy,
    KeyHandle = Enrollment.LocalKeyHandle,  // loaded from the key store
    AgentProvider = { RefreshEndpoint = Enrollment.RefreshEndpoint },
    EnableResourceManagedAccess = true,
    HandleInteractions = true,
});

// Page: reuse the enrolled agent's client. This request's consent handler
// shows the user the Inbox consent URL (interaction.BuildUserUrl()).
var inbox = Config["AAuth:Inbox"]!.TrimEnd('/');
var client = Enrollment.Agent.HttpClient;

// First call drives the 202 → consent → poll handshake.
using var request = new HttpRequestMessage(HttpMethod.Get, $"{inbox}/messages");
request.Options.Set(AAuthRequestOptions.InteractionHandler, consent);
await client.SendAsync(request);
// Subsequent calls replay Authorization: AAuth, bound to the signature.
var resp = await client.GetAsync($"{inbox}/messages");</code></pre>
</div>
<div class="col-md-6">
<h5>Server Code</h5>
<pre><code class="language-csharp">// One DI call: verifier, JTI store, and the published
// metadata (access_mode).
builder.Services.AddAAuthResource(o =&gt;
{
    o.EgressPolicy = SampleEgress.Policy;
    o.Issuer = "https://resource.example";
    o.SigningKeys["inbox-1"] = resourceKey;
    o.AccessMode = AAuthConstants.AccessModes.SessionToken;
});

// Resource-managed interaction module: the SDK owns the
// opaque-token store, the pending store, code generation,
// parking, the poll endpoint, and token issuance. The
// Inbox keeps only its own consent page.
builder.Services.AddAAuthResourceManaged(o =&gt;
{
    o.ConsentUrl = "https://resource.example/consent";
    o.PollPath = "/pending";
});

var app = builder.Build();
var store = app.Services.GetRequiredService&lt;IOpaqueTokenStore&gt;();

app.MapAAuthWellKnown();

// Verify the agent JWT issuer, expiry and cnf key, then the HTTP signature.
// Authorization belongs to the Inbox; no PS/AS auth-token exchange occurs.
app.UseRouting();
app.UseAAuth();

// Serve messages when a valid AAuth-Access token is presented;
// otherwise open a consent interaction at the Inbox's own page.
app.MapGet("/messages", async (HttpContext ctx) =&gt;
{
    // ResolveAAuthAccessAsync token68-validates Authorization:
    // AAuth, confirms the signature covered it, and looks it
    // up in the store.
    var info = await ctx.ResolveAAuthAccessAsync(store);
    if (info is not null)
        return Results.Ok(new { scope = info.Scope, messages });

    // The SDK parks the request and returns 202 + interaction;
    // its poll endpoint issues the AAuth-Access token once the
    // user approves at the consent page.
    return ctx.RequireAAuthInteraction("inbox.read");
}).RequireAAuthSignature();

// The deferred-response poll target, mapped by the SDK from the
// module's PollPath — the Inbox owns no poll plumbing.
app.MapAAuthInteractionPoll().RequireAAuthSignature();</code></pre>
</div>
</div>

<button class="btn btn-primary" @onclick="SendRequest" disabled="@_loading">
    @(_loading ? "Waiting…" : "Read my inbox")
</button>

@if (_consentUrl is not null && _messages is null)
{
    <div class="mt-3 alert alert-info">
        <strong>The Inbox needs your approval.</strong>
        <ConsentProgress Dashboard="false" ConsentPath="/consent" DecisionPath="/consent" />
        Sign in at its consent page, submit <em>Approve</em> or <em>Deny</em>, then return here —
        the SDK is polling and will continue automatically.
        <div class="mt-2">
            <a class="btn btn-success btn-sm" href="@_consentUrl" target="_blank" rel="noopener" id="consent-link">
                Approve at the Inbox →
            </a>
        </div>
    </div>
}

@if (_status is not null)
{
    <div class="mt-3">
        <h5>Response</h5>
        <div class="alert @(_success ? "alert-success" : "alert-warning")">
            <strong>@_status</strong>
        </div>
        @if (_messages is not null)
        {
            <pre><code class="language-json">@_messages</code></pre>
        }
    </div>
}

@if (_error is not null)
{
    <div class="mt-3 alert alert-danger">@_error</div>
}

@code {
    [Inject] private IConfiguration Config { get; set; } = default!;

    private bool _loading;
    private string? _consentUrl;
    private string? _messages;
    private string? _status;
    private bool _success;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("highlightCode");
    }

    private async Task SendRequest()
    {
        _loading = true;
        _consentUrl = null;
        _messages = null;
        _status = null;
        _error = null;

        try
        {
            await Enrollment.EnsureEnrolledAsync();
            var inbox = Config["AAuth:Inbox"]!.TrimEnd('/');
            var client = Enrollment.Agent.HttpClient;

            // Demo: start without the Inbox's access token so every run asks for consent.
            Enrollment.StartOver(inbox);

            // 1. Drive the 202 → consent → poll handshake (blocks until approved).
            using (var request = new HttpRequestMessage(HttpMethod.Get, $"{inbox}/messages"))
            {
                request.Options.Set(AAuthRequestOptions.InteractionHandler, this);
                using var first = await client.SendAsync(request);
            }

            // 2. Replay the captured token to read the inbox.
            using var response = await client.GetAsync($"{inbox}/messages");
            _status = $"{(int)response.StatusCode} {response.ReasonPhrase}";
            _success = response.IsSuccessStatusCode;
            var raw = await response.Content.ReadAsStringAsync();
            try
            {
                _messages = System.Text.Json.JsonSerializer.Serialize(
                    System.Text.Json.JsonDocument.Parse(raw),
                    new System.Text.Json.JsonSerializerOptions
                    {
                        WriteIndented = true,
                        Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
                    });
            }
            catch { _messages = raw; }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    // Surface the Inbox's own consent URL; the SDK keeps polling until the user decides.
    public async Task OnInteractionRequiredAsync(AAuth.Headers.Interaction interaction, CancellationToken cancellationToken)
    {
        _consentUrl = interaction.BuildUserUrl();
        await InvokeAsync(StateHasChanged);
    }
}
