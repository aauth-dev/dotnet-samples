@page "/mission-call-chain"
@using System.Net
@using System.Net.Http.Json
@using System.Text.Json.Nodes
@using AAuth
@using AAuth.Agent
@using AAuth.Agent.Governance
@using AAuth.Crypto
@using AAuth.Discovery
@using AAuth.Headers
@using AAuth.HttpSig
@using AAuth.Tokens
@implements IAAuthInteractionHandler
@implements IAAuthClarificationHandler
@inject IJSRuntime JS
@inject SampleAgents Agents
@rendermode InteractiveServer

<PageTitle>Mission Call Chain — clarification + governed delegation</PageTitle>

<h2>Mission Call Chain — one mission governs a clarification chat <em>and</em> a delegated chain</h2>

<details class="alert alert-primary aria-narrative" open>
    <summary>📖 What Aria is trying to do</summary>
    Under a single trip-planning mission,
    Aria (your AI travel assistant) first <em>clarifies</em> what you want, then <em>delegates</em> the work down a
    chain of services to reach your <strong>Trips</strong> — and every step, the
    clarification and each hop, is governed by the one mission you approved.
</details>

<p>
    This page joins the <strong>gates</strong> of the Mission demo with the <strong>hops</strong> of
    the Call Chain demo, combining three AAuth capabilities under a
    <strong>single human-approved mission</strong>:
</p>
<ol>
    <li>
        <strong>Clarification chat</strong> (§Clarification Chat) — accessing an out-of-mission
        elevated scope, the Person Server first asks the agent a question; the SDK surfaces it
        through the request's <code>AAuthRequestOptions.ClarificationHandler</code> (agent-wide:
        <code>ChallengeHandlingOptions.OnClarificationRequired</code>; lower-level:
        <code>TokenExchangeRequest.OnClarificationRequired</code>), the agent answers, then the
        user approves.
    </li>
    <li>
        <strong>Mission-forwarded call chain</strong> (§Mission Context at Resources, §Call Chaining) —
        the same mission is carried (<code>AAuthRequestOptions.MissionS256</code>) to the Concierge, whose
        downstream Trips hop is requested under the upstream token, so the mission governs every hop.
    </li>
    <li>
        <strong>Mission log</strong> (§Mission Log) — the PS-held, ordered trail of every governed
        step the mission accrued is fetched and shown at the end.
    </li>
</ol>

<div class="alert alert-secondary">
    The elevated scope is <em>not</em> seeded in the mission's intent, so the PS runs a clarification
    round before prompting. The concierge + trips.read scopes <em>are</em> seeded in-scope, so the chain
    hops resolve silently — keeping the chain focused on mission <strong>forwarding</strong>, not consent.
    Each step is labelled <span class="badge bg-warning text-dark">prompt</span> (the user must decide)
    or <span class="badge bg-success">silent</span> (resolved without a screen).
</div>

<div class="row">
    <div class="col-md-6">
        <h5>Client Code — the clarification callback</h5>
        <pre><code class="language-csharp">// One mission, threaded through every step. governance is Aria's keyed
// AAuthGovernanceClient; deferred handling is passed per call.
var session = await governance.ProposeMissionAsync(
    new MissionProposal("Plan my weekend trip to Seattle."),
    new GovernanceOptions { OnInteractionRequired = consent.OnInteractionRequiredAsync });
var mission = session.Mission;

// Out-of-mission elevated scope: the PS asks a question first. The SDK
// surfaces it via this request's clarification handler; the agent answers
// (or updates / cancels), then the normal interaction approval runs
// (§Clarification Chat). The page implements IAAuthClarificationHandler:
// question.Clarification is UNTRUSTED Markdown — render it sanitized
// (Blazor HTML-encodes it), then return ClarificationResponse.Respond(
//     "Booking the trip needs permission to reserve and pay.").
var client = clients.CreateClient("aria");
using var request = new HttpRequestMessage(HttpMethod.Get, elevatedUrl);
request.Options.Set(AAuthRequestOptions.MissionS256, mission.S256);
request.Options.Set(AAuthRequestOptions.MissionPersonTokens, mission.PersonTokens);
request.Options.Set(AAuthRequestOptions.InteractionHandler, consent);
request.Options.Set(AAuthRequestOptions.ClarificationHandler, clarify);
using var elevated = await client.SendAsync(request);</code></pre>
    </div>
    <div class="col-md-6">
        <h5>Client Code — the mission-forwarded chain</h5>
        <pre><code class="language-csharp">// Carry the SAME mission to the Concierge on Aria's client. MissionS256
// requests the person token with mission_s256; the Concierge copies it
// into its resource token, so the agent-&gt;concierge exchange is governed
// by the mission. The Concierge's downstream hop carries the auth token
// as upstream_token, which keeps the same mission (§Call Chaining).
// The consent handler receives PS interactions (Source == PersonServer)
// and the Concierge's resource 202s (Source == Resource) alike.
using var chainRequest = new HttpRequestMessage(HttpMethod.Get, $"{concierge}/mission");
chainRequest.Options.Set(AAuthRequestOptions.MissionS256, mission.S256);
chainRequest.Options.Set(AAuthRequestOptions.MissionPersonTokens, mission.PersonTokens);
chainRequest.Options.Set(AAuthRequestOptions.InteractionHandler, consent);

// "/mission" is the Concierge's mission-aware twin of "/": it chains to
// Trips' "/trips" so the forwarded mission re-binds at the next hop.
var response = await clients.CreateClient("aria").SendAsync(chainRequest);</code></pre>
    </div>
</div>

<div class="alert alert-info">
    Self-issued agent identity. Key ID: <code>@_identity.KeyId</code>,
    agent: <code>@_identity.AgentId</code>.
</div>

@if (!_running && _steps.Count == 0)
{
    <button class="btn btn-primary" @onclick="RunFlow">Run the combined flow</button>
    <p class="text-muted mt-1">
        <small>
            Two prompts in a new tab (mission creation, then the elevated scope after a
            clarification round); the call chain then resolves silently.
        </small>
    </p>
}

@if (_running)
{
    <button class="btn btn-secondary" disabled>
        <span class="spinner-border spinner-border-sm" role="status"></span>
        Running&hellip;
    </button>
}

@if (_clarification is not null)
{
    @* The clarification text is UNTRUSTED PS input. Razor HTML-encodes it here,
       so no markup from the PS can reach the DOM (§Markdown — sanitize before
       rendering). *@
    <div class="mt-3 alert alert-primary" data-test="clarification">
        <h5>Clarification chat (§Clarification Chat)</h5>
        <p class="mb-1"><strong>PS asked:</strong> @_clarification</p>
        <p class="mb-0"><strong>Agent answered:</strong> @_clarificationAnswer</p>
    </div>
}

@if (_steps.Count > 0)
{
    <div class="mt-3">
        <h5>Steps</h5>
        @foreach (var s in _steps)
        {
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><strong>Step @s.Number</strong> — @s.Title</span>
                    <span>
                        @if (s.Prompted)
                        {
                            <span class="badge bg-warning text-dark me-1">prompt</span>
                        }
                        else
                        {
                            <span class="badge bg-success me-1">silent</span>
                        }
                        <span class="badge @OutcomeClass(s.Outcome)">@s.Outcome</span>
                    </span>
                </div>
                <div class="card-body">
                    <p class="mb-2">@s.Summary</p>
                    @if (s.Payload is not null)
                    {
                        <div class="text-muted small mb-1">@s.PayloadLabel</div>
                        <pre class="mb-0"><code class="language-@s.PayloadLang">@s.Payload</code></pre>
                    }
                </div>
            </div>
        }
    </div>
}

@if (_waitingForApproval && _interaction is not null)
{
    <div class="mt-3 alert alert-warning">
        <h5>User Approval Required — @_currentGate</h5>
        <p>
            This step fell <strong>outside</strong> the mission, so the Person Server returned
            <code>202 Accepted</code>. The SDK is already polling while it waits for your decision.
        </p>
        <PersonServerApprovalPrompt PersonServer="@Agents.PersonServer" Interaction="_interaction" />
    </div>
}

@if (_missionLog is not null)
{
    <div class="mt-3">
        <h5>Mission log (§Mission Log) — held at the Person Server</h5>
        <p class="text-muted small">
            The PS keeps the authoritative, ordered trail of every governed step under the mission.
        </p>
        <table class="table table-sm" data-test="mission-log">
            <thead>
                <tr><th>#</th><th>Kind</th><th>Resource / Action</th><th>Scope</th><th>Granted</th><th>Detail</th></tr>
            </thead>
            <tbody>
                @{ var i = 1; }
                @foreach (var e in _missionLog)
                {
                    <tr>
                        <td>@i</td>
                        <td><code>@e.Kind</code></td>
                        <td>@(e.Resource ?? e.Action ?? "—")</td>
                        <td>@(e.Scope ?? "—")</td>
                        <td>@(e.Granted?.ToString() ?? "—")</td>
                        <td class="small">@(e.Detail ?? "—")</td>
                    </tr>
                    i++;
                }
            </tbody>
        </table>
    </div>
}

@if (_error is not null)
{
    <div class="mt-3 alert alert-danger">@_error</div>
}

@code {
    [Inject] private SelfIssuedIdentity _identity { get; set; } = default!;
    [Inject] private IConfiguration Config { get; set; } = default!;
    [Inject(Key = SampleAgents.Aria)] private AAuthGovernanceClient Governance { get; set; } = default!;

    private readonly List<Step> _steps = new();
    private bool _running;
    private bool _waitingForApproval;
    private string? _currentGate;
    private Interaction? _interaction;
    private string? _clarification;
    private string? _clarificationAnswer;
    private IReadOnlyList<LogEntry>? _missionLog;
    private string? _error;

    private sealed record Step(
        int Number,
        string Title,
        bool Prompted,
        string Outcome,
        string Summary,
        string? Payload = null,
        string PayloadLabel = "",
        string PayloadLang = "json");

    private sealed record LogEntry(
        string Kind, string? Resource, string? Scope, string? Action, bool? Granted, string? Detail);

    private static string OutcomeClass(string outcome) => outcome switch
    {
        "denied" => "bg-danger",
        _ => "bg-success",
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("highlightCode");
    }

    private async Task RunFlow()
    {
        _running = true;
        _steps.Clear();
        _error = null;
        _clarification = null;
        _clarificationAnswer = null;
        _missionLog = null;
        ClearWaiting();

        var personServer = Agents.PersonServer.TrimEnd('/');
        var resourceOrigin = Config["AAuth:Trips"]!.TrimEnd('/');
        var conciergeUrl = Config["AAuth:Concierge"]!.TrimEnd('/');
        var elevatedUrl = $"{resourceOrigin}/trips/book";

        try
        {
            // Script the PS: interactive browser decisions, a clarification round
            // on out-of-scope tokens, and BOTH chain scopes seeded in-scope so the
            // chain hops resolve silently. The in-scope set is captured per mission
            // at approval, so it must be seeded BEFORE proposing.
            await ConfigurePersonServerAsync(personServer, resourceOrigin, conciergeUrl);

            // Demo: start from no grant, as each run did with its own client.
            Agents.StartOver();

            // Aria's governance client takes deferred handling per call.
            var governanceOptions = new GovernanceOptions
            {
                OnInteractionRequired = OnInteractionRequiredAsync,
                PollerOptions = Agents.PollerOptions,
            };

            // ---- Step 1: propose the mission (PROMPT) ----------------------
            _currentGate = "Mission creation";
            var session = await Governance.ProposeMissionAsync(new MissionProposal(
                "Plan my weekend trip to Seattle.")
            {
                Tools = new[] { new MissionTool("compare_options", "Compare flight and hotel options") },
            }, governanceOptions);
            var mission = session.Mission;
            ClearWaiting();
            _steps.Add(new Step(1, "Mission creation", Prompted: true, Outcome: "approved",
                Summary: $"The user approved the mission's intent and {mission.ApprovedTools.Count} tool(s). " +
                         "The mission lists NO scopes — scopes are evaluated later against its intent.",
                Payload: MissionPayload(mission),
                PayloadLabel: "Mission approval (held at the PS)"));
            await InvokeAsync(StateHasChanged);

            // ---- Step 2: elevated scope via a clarification round (PROMPT) -
            _currentGate = "Elevated scope (with clarification)";
            var elevated = await AccessElevatedWithClarificationAsync(elevatedUrl, mission);
            ClearWaiting();
            _steps.Add(new Step(2, "Elevated scope + clarification", Prompted: true, Outcome: "granted",
                Summary: "The elevated scope falls outside the mission's intent, so the PS asked a " +
                         "clarification question first; the agent answered, the user approved, and the " +
                         $"auth_token was minted. scope={elevated?["scope"]?.ToJsonString()}",
                Payload: Pretty(elevated),
                PayloadLabel: "Elevated mission-aware resource response (auth_token claims)"));
            await InvokeAsync(StateHasChanged);

            // ---- Step 3: mission-forwarded call chain (SILENT) -------------
            _currentGate = "Mission call chain";
            var chainJson = await RunMissionChainAsync(conciergeUrl, mission);
            _steps.Add(new Step(3, "Mission call chain", Prompted: false, Outcome: "granted",
                Summary: "The same mission was carried to the Concierge (mission_s256 request option), whose " +
                         "downstream Trips hop kept it through the upstream token. Both hops were in-scope, " +
                         "so the chain resolved without a prompt — the mission governed every hop.",
                Payload: chainJson,
                PayloadLabel: "Chain result (Agent → Concierge → Trips /trips)"));
            await InvokeAsync(StateHasChanged);

            // ---- Mission log: the PS-held trail the mission accrued --------
            _missionLog = await FetchMissionLogAsync(personServer, mission.S256);
            await InvokeAsync(StateHasChanged);
        }
        catch (AAuthInteractionDeniedException)
        {
            _error = "The user denied a consent request.";
        }
        catch (AAuthInteractionTimeoutException)
        {
            _error = "Timed out waiting for user approval (polling budget expired).";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            ClearWaiting();
            _running = false;
        }
    }

    // A request on Aria's client under the mission: the SDK requests the person token
    // with mission_s256 (or reuses one the approval issued) and runs the challenge.
    private HttpRequestMessage MissionRequest(string url, AAuth.Agent.Mission mission)
    {
        var request = new HttpRequestMessage(HttpMethod.Get, url);
        request.Options.Set(AAuthRequestOptions.MissionS256, mission.S256);
        request.Options.Set(AAuthRequestOptions.MissionPersonTokens, mission.PersonTokens);
        request.Options.Set(AAuthRequestOptions.InteractionHandler, this);
        return request;
    }

    // Challenge -> token exchange (with a clarification round) -> retry, inside the
    // SDK. OnClarificationRequiredAsync surfaces the (sanitized) question and answers
    // it; the PS then prompts the user for the out-of-mission scope.
    private async Task<JsonObject?> AccessElevatedWithClarificationAsync(
        string resourceUrl,
        AAuth.Agent.Mission mission)
    {
        using var request = MissionRequest(resourceUrl, mission);
        request.Options.Set(AAuthRequestOptions.ClarificationHandler, this);
        using var ok = await Agents.AriaClient.SendAsync(request);
        ok.EnsureSuccessStatusCode();
        return await ok.Content.ReadFromJsonAsync<JsonObject>();
    }

    // The PS asks a question during review. question.Clarification is UNTRUSTED
    // Markdown from the PS: we store it for HTML-encoded (sanitized) rendering only,
    // never as raw markup (§Markdown — sanitize before rendering).
    public Task<ClarificationResponse> OnClarificationRequiredAsync(
        ClarificationRequirement question, CancellationToken cancellationToken)
    {
        _clarificationAnswer = "Booking the trip needs permission to reserve and pay.";
        SurfaceClarification(question.Clarification);
        return Task.FromResult(ClarificationResponse.Respond(_clarificationAnswer));
    }

    // Carry the mission to the Concierge's "/mission" endpoint. The mission_s256
    // request option requests the person token under the mission; the Concierge
    // copies it into its resource token (so the exchange is governed by the
    // mission), and its downstream Trips hop keeps the mission through the
    // upstream token.
    private async Task<string> RunMissionChainAsync(string conciergeUrl, AAuth.Agent.Mission mission)
    {
        using var request = MissionRequest($"{conciergeUrl}/mission", mission);
        using var response = await Agents.AriaClient.SendAsync(request);
        var raw = await response.Content.ReadAsStringAsync();
        try
        {
            return System.Text.Json.JsonSerializer.Serialize(
                System.Text.Json.JsonDocument.Parse(raw),
                new System.Text.Json.JsonSerializerOptions
                {
                    WriteIndented = true,
                    Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
                });
        }
        catch { return raw; }
    }

    private async Task<IReadOnlyList<LogEntry>> FetchMissionLogAsync(string personServer, string s256)
    {
        using var http = new SampleHttpClient();
        try
        {
            var doc = await http.GetFromJsonAsync<JsonObject>(
                $"{personServer}/admin/mission-log/{Uri.EscapeDataString(s256)}");
            var entries = doc?["entries"] as JsonArray ?? new JsonArray();
            var list = new List<LogEntry>();
            foreach (var e in entries.OfType<JsonObject>())
            {
                list.Add(new LogEntry(
                    (string?)e["kind"] ?? "?",
                    (string?)e["resource"],
                    (string?)e["scope"],
                    (string?)e["action"],
                    (bool?)e["granted"],
                    (string?)e["detail"]));
            }
            return list;
        }
        catch
        {
            return Array.Empty<LogEntry>();
        }
    }

    private async Task SurfaceClarificationAsync(string question)
    {
        _clarification = question;
        await InvokeAsync(StateHasChanged);
    }

    // Synchronous wrapper used inside the clarification callback (which is not
    // awaited for the UI update — the SDK continues immediately).
    private void SurfaceClarification(string question)
        => _ = SurfaceClarificationAsync(question);

    // PS interactions (mission, token exchange) surface as-is; the Concierge's resource
    // 202 points at the PS consent page.
    public Task OnInteractionRequiredAsync(Interaction interaction, CancellationToken ct)
        => SurfaceInteraction(interaction.Source == InteractionSource.Resource
            ? PersonServerConsent.FromUserUrl(interaction.BuildUserUrl(), interaction.Code)
            : interaction, ct);

    private async Task SurfaceInteraction(Interaction interaction, CancellationToken ct)
    {
        _interaction = interaction;
        _waitingForApproval = true;
        // Surface the approval banner with a single render. We deliberately do
        // NOT spin up a per-second "poll count" timer here: while the user is in
        // the approval popup the main tab is backgrounded, and a background timer
        // calling StateHasChanged every second floods Blazor Server's
        // unacknowledged render-batch buffer (the throttled background tab stops
        // ACKing), which pauses ALL rendering — including the result card the
        // flow renders once approval completes. A static spinner conveys the same
        // "polling" state without the render-batch flood.
        await InvokeAsync(StateHasChanged);
    }

    private void ClearWaiting()
    {
        _waitingForApproval = false;
        _interaction = null;
    }

    private async Task ConfigurePersonServerAsync(
        string personServer, string resourceOrigin, string conciergeUrl)
    {
        using var http = new SampleHttpClient();
        try
        {
            await http.PostAsJsonAsync($"{personServer}/admin/reset", new { });
            await http.PostAsJsonAsync($"{personServer}/admin/mission-script", new
            {
                reset = true,
                interactive = true,
                approveMission = true,
                approveToken = true,
                approvePermission = true,
                requireClarification = true,
                clarificationQuestion =
                    "Why does this mission need to book and pay for a trip?",
                inScope = new[]
                {
                    new { resource = conciergeUrl, scope = "concierge" },
                    new { resource = resourceOrigin, scope = "trips.read" },
                },
            });
        }
        catch
        {
            // Admin endpoints only exist on MockPersonServer — swallow errors.
        }
    }

    private static string MissionPayload(AAuth.Agent.Mission m)
    {
        var tools = new JsonArray();
        foreach (var t in m.ApprovedTools)
        {
            tools.Add(new JsonObject { ["name"] = t.Name, ["description"] = t.Description });
        }
        return Pretty(new JsonObject
        {
            ["person_server"] = m.PersonServer,
            ["s256"] = m.S256,
            ["approved_tools"] = tools,
        });
    }

    private static string Pretty(JsonObject? json) => json is null
        ? "(no body)"
        : System.Text.Json.JsonSerializer.Serialize(json, new System.Text.Json.JsonSerializerOptions
        {
            WriteIndented = true,
            Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
        });
}
