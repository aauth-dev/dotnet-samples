@page "/hwk"
@using AAuth.Crypto
@using AAuth.HttpSig
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>HWK — Pseudonymous</PageTitle>

<h2>HWK — Pseudonymous Signing</h2>

<p>
    The simplest mode. No enrollment required. Generate a key and sign requests.
    The resource sees a stable pseudonymous identity (the key's JWK thumbprint)
    but cannot link it to a real-world identity.
</p>

<div class="row">
<div class="col-md-6">
<h5>Client Code</h5>
<pre><code class="language-csharp">var key = AAuthKey.Generate();

using var client = new AAuthClientBuilder(key)
    .UseHwk()
    .Build();</code></pre>
</div>
<div class="col-md-6">
<h5>Server Code</h5>
<pre><code class="language-csharp">builder.Services.AddSingleton(new AAuthVerifier());

var app = builder.Build();

// HWK carries the public key inline; no JWKS needed.
app.UseAAuthVerification(new AAuthVerificationOptions
{
    RequireIssuerVerification = false,
});

app.MapGet("/hwk", (HttpContext ctx) =>
{
    var parsed = ctx.GetAAuthParsedKey()!;
    return Results.Ok(new
    {
        mode = "pseudonymous",
        scheme = "hwk",
        jkt = parsed.Jkt,
    });
});</code></pre>
</div>
</div>

<button class="btn btn-primary" @onclick="SendRequest" disabled="@_loading">
    @(_loading ? "Sending..." : "Send Signed Request")
</button>

@if (_response is not null)
{
    <div class="mt-3">
        <h5>Response</h5>
        <div class="alert @(_success ? "alert-success" : "alert-warning")">
            <strong>@_statusCode</strong>
        </div>
        <pre><code class="language-json">@_response</code></pre>
    </div>
}

@if (_error is not null)
{
    <div class="mt-3 alert alert-danger">@_error</div>
}

@code {
    [Inject] private IConfiguration Config { get; set; } = default!;

    private bool _loading;
    private string? _response;
    private string? _error;
    private string? _statusCode;
    private bool _success;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("highlightCode");
    }

    private async Task SendRequest()
    {
        _loading = true;
        _response = null;
        _error = null;

        try
        {
            // Generate a fresh key (in production, load from keystore)
            var key = AAuthKey.Generate();

            // Build the signed client — hwk mode, no enrollment
            using var client = new AAuthClientBuilder(key)
                .UseHwk()
                .Build();

            var resourceUrl = Config["AAuth:Resource"]!;
            var response = await client.GetAsync($"{resourceUrl.TrimEnd('/')}/hwk");

            _statusCode = $"{(int)response.StatusCode} {response.ReasonPhrase}";
            _success = response.IsSuccessStatusCode;
            var raw = await response.Content.ReadAsStringAsync();
            try { _response = System.Text.Json.JsonSerializer.Serialize(System.Text.Json.JsonDocument.Parse(raw), new System.Text.Json.JsonSerializerOptions { WriteIndented = true, Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping }); }
            catch { _response = raw; }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
