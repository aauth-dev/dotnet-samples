@page "/calendar-deferred"
@using AAuth.Agent
@using AAuth.Crypto
@using AAuth.Headers
@using AAuth.HttpSig
@implements IAAuthInteractionHandler
@inject IJSRuntime JS
@inject SampleAgents Agents
@rendermode InteractiveServer

<PageTitle>Deferred — User Consent</PageTitle>

<h2>Deferred — User Consent (Three-Party)</h2>

<details class="alert alert-primary aria-narrative" open>
    <summary>📖 What Aria is trying to do</summary>
    Aria (your AI travel assistant) wants to read your
    <strong>Calendar</strong> to plan around your schedule, but you haven't pre-approved
    this yet. The Person Server pauses the request and asks you to approve it in another
    tab; Aria waits, then continues once you say yes.
</details>

<p>
    Full three-party flow with <strong>deferred consent</strong>: the Person Server
    requires explicit user approval before issuing an auth token. The SDK handles the
    <code>202 Accepted</code> response, surfaces the interaction URL, polls the pending
    endpoint, and retries the resource request once consent is granted.
</p>

<div class="row">
<div class="col-md-6">
<h5>Client Code</h5>
<pre><code class="language-csharp">// Program.cs: one agent for the app, bound from AAuth:Agents:aria
// (Person Server, self-issued identity, polling budgets).
builder.Services.AddAAuthAgent("aria",
    builder.Configuration.GetSection("AAuth:Agents:aria"),
    options =&gt; options.Signer = key);

// Page: reuse the agent's client and hand this request its own
// consent callback. The page implements IAAuthInteractionHandler:
// OnInteractionRequiredAsync points the user at the PS dashboard
// ({ps}/dashboard) or interaction.BuildUserUrl(); the SDK polls
// once it returns.
var client = clients.CreateClient("aria");
using var request = new HttpRequestMessage(HttpMethod.Get, $"{calendar}/events");
request.Options.Set(AAuthRequestOptions.InteractionHandler, consent);
var response = await client.SendAsync(request);</code></pre>
</div>
<div class="col-md-6">
<h5>Server Code</h5>
<pre><code class="language-csharp">// Same as JWT three-party — deferred consent
// is transparent to the resource server.
builder.Services.AddAAuthResource(o =&gt;
{
    o.EgressPolicy = SampleEgress.Policy;
    o.Issuer = "https://resource.example";
    o.SigningKeys["calendar-1"] = resourceKey;
    o.ScopeDescriptions = new()
    {
        ["calendar.read"] = "See your calendar events",
    };
});
builder.Services.AddAAuthAuthentication();
builder.Services.AddAAuthAuthorization();

var app = builder.Build();

// Well-known metadata + JWKS from the DI registration.
app.MapAAuthWellKnown();

// One declarative pipeline verifies and challenges
// each matched endpoint from its metadata. Trust
// only the configured Person Servers (fail-closed).
app.UseRouting();
app.UseAAuth(o =&gt;
    o.Trust.AuthTokenIssuers.Allowed = trustedPersonServers);

app.UseAuthentication();
app.UseAuthorization();

// Resource challenges on first call, accepts
// on retry after user approves via PS.
app.MapGet("/events", (HttpContext ctx) =&gt;
{
    // Middleware verified the auth token AND the
    // .RequireAAuth(...) below enforced the scope.
    var r = ctx.GetAAuthVerification()!;
    return Results.Ok(new
    {
        accessMode = "three-party",
        scheme = "jwt",
        ps = r.PersonServer,
        sub = r.Subject,
        scope = r.Scopes, // ["calendar.read"]
        iss = r.Issuer,
    });
})
.RequireAAuth(scope: "calendar.read");</code></pre>
</div>
</div>

<div class="alert alert-info">
    Self-issued agent identity. Key ID: <code>@_identity.KeyId</code>
</div>

@if (!_waitingForApproval && _response is null)
{
    <button class="btn btn-primary" @onclick="SendRequest" disabled="@_loading">
        @(_loading ? "Sending..." : "Send Signed Request to Resource")
    </button>
    <p class="text-muted mt-1">
        <small>The Person Server will require consent. An interaction URL will appear below.</small>
    </p>
}

@if (_waitingForApproval && _interaction is not null)
{
    <div class="mt-3 alert alert-warning">
        <h5>User Approval Required</h5>
        <ConsentProgress />
        <p>The Person Server returned <code>202 Accepted</code> and the SDK is already polling the pending endpoint.</p>
        <PersonServerApprovalPrompt PersonServer="@Agents.PersonServer" Interaction="_interaction" PollCount="_pollCount" />
    </div>
}

@if (_response is not null)
{
    <div class="mt-3">
        <h5>Response</h5>
        <div class="alert @(_success ? "alert-success" : "alert-warning")">
            <strong>@_statusCode</strong>
        </div>
        <pre><code class="language-json">@_response</code></pre>
    </div>
}

@if (_error is not null)
{
    <div class="mt-3 alert alert-danger">@_error</div>
}

@code {
    [Inject] private SelfIssuedIdentity _identity { get; set; } = default!;
    [Inject] private IConfiguration Config { get; set; } = default!;

    private bool _loading;
    private bool _waitingForApproval;
    private AAuth.Headers.Interaction? _interaction;
    private int _pollCount;
    private string? _response;
    private string? _error;
    private string? _statusCode;
    private bool _success;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("highlightCode");
    }

    private async Task SendRequest()
    {
        _loading = true;
        _response = null;
        _error = null;
        _waitingForApproval = false;
        _interaction = null;
        _pollCount = 0;

        try
        {
            // Demo: start from no grant so the deferred path triggers fresh each time.
            Agents.StartOver();
            await RevokeConsentAsync();

            var resourceUrl = Config["AAuth:Calendar"]!;

            // Start a background timer to update poll count in the UI
            using var pollTimer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            var pollTask = Task.Run(async () =>
            {
                while (await pollTimer.WaitForNextTickAsync())
                {
                    _pollCount++;
                    await InvokeAsync(StateHasChanged);
                }
            });

            using var request = new HttpRequestMessage(HttpMethod.Get, $"{resourceUrl.TrimEnd('/')}/events");
            request.Options.Set(AAuthRequestOptions.InteractionHandler, this);
            var response = await Agents.AriaClient.SendAsync(request);

            // Stop the poll counter
            pollTimer.Dispose();

            _waitingForApproval = false;
            _statusCode = $"{(int)response.StatusCode} {response.ReasonPhrase}";
            _success = response.IsSuccessStatusCode;
            var raw = await response.Content.ReadAsStringAsync();
            try { _response = System.Text.Json.JsonSerializer.Serialize(System.Text.Json.JsonDocument.Parse(raw), new System.Text.Json.JsonSerializerOptions { WriteIndented = true, Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping }); }
            catch { _response = raw; }
        }
        catch (AAuthInteractionDeniedException)
        {
            _waitingForApproval = false;
            _error = "The user denied the consent request.";
        }
        catch (AAuthInteractionTimeoutException)
        {
            _waitingForApproval = false;
            _error = "Timed out waiting for user approval (polling budget expired).";
        }
        catch (Exception ex)
        {
            _waitingForApproval = false;
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    // Surface the interaction in the UI; the SDK polls once this returns.
    public async Task OnInteractionRequiredAsync(AAuth.Headers.Interaction interaction, CancellationToken cancellationToken)
    {
        _interaction = interaction;
        _waitingForApproval = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task RevokeConsentAsync()
    {
        var personServer = Agents.PersonServer;
        if (string.IsNullOrEmpty(personServer)) return;

        var agentId = _identity.AgentId;
        var resource = Config["AAuth:Calendar"]!;

        using var http = new SampleHttpClient();
        try
        {
            await http.PostAsJsonAsync(
                $"{personServer.TrimEnd('/')}/admin/revoke",
                new { agent = agentId, resource = resource.TrimEnd('/') });
        }
        catch
        {
            // /admin/revoke only exists on MockPersonServer — swallow errors
        }
    }
}
