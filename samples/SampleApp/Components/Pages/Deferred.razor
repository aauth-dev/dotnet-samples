@page "/deferred"
@using AAuth.Agent
@using AAuth.Crypto
@using AAuth.Headers
@using AAuth.HttpSig
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Deferred — User Consent</PageTitle>

<h2>Deferred — User Consent (Three-Party)</h2>

<p>
    Full three-party flow with <strong>deferred consent</strong>: the Person Server
    requires explicit user approval before issuing an auth token. The SDK handles the
    <code>202 Accepted</code> response, surfaces the interaction URL, polls the pending
    endpoint, and retries the resource request once consent is granted.
</p>

<div class="row">
<div class="col-md-6">
<h5>Client Code</h5>
<pre><code class="language-csharp">using var client = AAuthClientBuilder.Enrolled(key)
    .RefreshingFrom(refreshEndpoint, localKeyHandle)
    .WithKeyStore(keyStore)
    .WithPersonServer(personServer)
    .WithChallengeHandling(opts =>
    {
        opts.OnInteractionRequired =
            async (interaction, ct) =>
        {
            var url = interaction.BuildUserUrl();
            // Surface URL to user
        };
        opts.PollingTimeout =
            TimeSpan.FromMinutes(2);
        opts.DefaultPollInterval =
            TimeSpan.FromSeconds(1);
    })
    .Build();</code></pre>
</div>
<div class="col-md-6">
<h5>Server Code</h5>
<pre><code class="language-csharp">// Same as JWT three-party — deferred consent
// is transparent to the resource server.
builder.Services.AddSingleton(new AAuthVerifier());
builder.Services.AddSingleton(sp =&gt;
    new MetadataClient(httpClient));
builder.Services.AddSingleton(sp =&gt;
    new JwksClient(httpClient));

var app = builder.Build();

// Middleware verifies HTTP signature AND the
// JWT issuer (via JWKS discovery).
app.UseAAuthVerification(new AAuthVerificationOptions
{
    ResourceIdentifier = "https://resource.example",
    RequireIssuerVerification = true,
});

app.UseAAuthChallenge(new ChallengeOptions
{
    AccessMode = AAuthAccessMode.RequireAuthToken,
});

// Resource challenges on first call, accepts
// on retry after user approves via PS.
app.MapGet("/jwt", (HttpContext ctx) =&gt;
{
    // Middleware already verified the auth token.
    var r = ctx.Features
        .Get&lt;AAuthVerificationResult&gt;()!;
    return Results.Ok(new
    {
        mode = "three-party",
        scheme = "jwt",
        agent = r.Agent,
        sub = r.Subject,
        scope = r.Scopes, // ["whoami"]
        iss = r.Issuer,
    });
});</code></pre>
</div>
</div>

<div class="alert alert-info">
    Self-issued agent identity. Key ID: <code>@_identity.KeyId</code>
</div>

@if (!_waitingForApproval && _response is null)
{
    <button class="btn btn-primary" @onclick="SendRequest" disabled="@_loading">
        @(_loading ? "Sending..." : "Send Signed Request to Resource")
    </button>
    <p class="text-muted mt-1">
        <small>The Person Server will require consent. An interaction URL will appear below.</small>
    </p>
}

@if (_waitingForApproval)
{
    <div class="mt-3 alert alert-warning">
        <h5>User Approval Required</h5>
        <p>The Person Server returned <code>202 Accepted</code> and is waiting for the user to approve.</p>
        <p>
            <strong>Interaction URL:</strong><br />
            <a href="@_interactionUrl" target="_blank" rel="noopener">@_interactionUrl</a>
        </p>
        <p class="text-muted">
            Open the link above in a new tab and click <strong>Approve</strong>.
            The SDK is polling the pending endpoint in the background&hellip;
            <span class="spinner-border spinner-border-sm" role="status"></span>
            (@_pollCount polls)
        </p>
    </div>
}

@if (_response is not null)
{
    <div class="mt-3">
        <h5>Response</h5>
        <div class="alert @(_success ? "alert-success" : "alert-warning")">
            <strong>@_statusCode</strong>
        </div>
        <pre><code class="language-json">@_response</code></pre>
    </div>
}

@if (_error is not null)
{
    <div class="mt-3 alert alert-danger">@_error</div>
}

@code {
    [Inject] private SelfIssuedIdentity _identity { get; set; } = default!;
    [Inject] private IConfiguration Config { get; set; } = default!;

    private bool _loading;
    private bool _waitingForApproval;
    private string? _interactionUrl;
    private int _pollCount;
    private string? _response;
    private string? _error;
    private string? _statusCode;
    private bool _success;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("highlightCode");
    }

    private async Task SendRequest()
    {
        _loading = true;
        _response = null;
        _error = null;
        _waitingForApproval = false;
        _interactionUrl = null;
        _pollCount = 0;

        try
        {
            // Revoke consent so the deferred path triggers fresh each time
            await RevokeConsentAsync();

            var personServer = Config["AAuth:PersonServer"]!;

            // Self-issued token refresh + deferred consent support
            using var client = AAuthClientBuilder.SelfIssuing(_identity.Key)
                .As(_identity.Issuer, _identity.AgentId)
                .WithKid(_identity.KeyId)
                .WithPersonServer(personServer)
                .WithChallengeHandling(opts =>
                {
                    opts.OnInteractionRequired = async (interaction, ct) =>
                    {
                        // Surface the interaction URL in the UI
                        _interactionUrl = interaction.BuildUserUrl();
                        _waitingForApproval = true;
                        await InvokeAsync(StateHasChanged);
                    };
                    opts.PollingTimeout = TimeSpan.FromMinutes(2);
                    opts.DefaultPollInterval = TimeSpan.FromSeconds(1);
                })
                .Build();

            var resourceUrl = Config["AAuth:Resource"]!;

            // Start a background timer to update poll count in the UI
            using var pollTimer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            var pollTask = Task.Run(async () =>
            {
                while (await pollTimer.WaitForNextTickAsync())
                {
                    _pollCount++;
                    await InvokeAsync(StateHasChanged);
                }
            });

            var response = await client.GetAsync($"{resourceUrl.TrimEnd('/')}/jwt");

            // Stop the poll counter
            pollTimer.Dispose();

            _waitingForApproval = false;
            _statusCode = $"{(int)response.StatusCode} {response.ReasonPhrase}";
            _success = response.IsSuccessStatusCode;
            var raw = await response.Content.ReadAsStringAsync();
            try { _response = System.Text.Json.JsonSerializer.Serialize(System.Text.Json.JsonDocument.Parse(raw), new System.Text.Json.JsonSerializerOptions { WriteIndented = true, Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping }); }
            catch { _response = raw; }
        }
        catch (AAuthInteractionDeniedException)
        {
            _waitingForApproval = false;
            _error = "The user denied the consent request.";
        }
        catch (AAuthInteractionTimeoutException)
        {
            _waitingForApproval = false;
            _error = "Timed out waiting for user approval (polling budget expired).";
        }
        catch (Exception ex)
        {
            _waitingForApproval = false;
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RevokeConsentAsync()
    {
        var personServer = Config["AAuth:PersonServer"];
        if (string.IsNullOrEmpty(personServer)) return;

        var agentId = _identity.AgentId;
        var resource = Config["AAuth:Resource"]!;

        using var http = new HttpClient();
        try
        {
            await http.PostAsJsonAsync(
                $"{personServer.TrimEnd('/')}/admin/revoke",
                new { agent = agentId, resource = resource.TrimEnd('/') });
        }
        catch
        {
            // /admin/revoke only exists on MockPersonServer — swallow errors
        }
    }
}
