@page "/calendar"
@using AAuth.Crypto
@using AAuth.HttpSig
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>JWT — Agent Token</PageTitle>

<h2>JWT — Agent Token (Three-Party)</h2>

<details class="alert alert-primary aria-narrative" open>
    <summary>📖 What Aria is trying to do</summary>
    Aria (your AI travel assistant) is planning a trip and needs to
    see when you're free, so it reads your <strong>Calendar</strong>. Because you granted
    standing consent earlier, the Person Server issues a token immediately — Aria never
    has to interrupt you.
</details>

<p>
    PS-asserted access: SampleApp acts as its own Agent Provider and publishes
    its metadata and signing key. The SDK locally issues and refreshes an
    <code>aa-agent+jwt</code> using that identity, presented with the
    <code>jwt</code> signature scheme. Challenge handling automates the Person
    Server consent exchange. There is no external AP enrollment in this page.
</p>

<div class="row">
<div class="col-md-6">
<h5>Client Code</h5>
<pre><code class="language-csharp">// _identity is the injected SelfIssuedIdentity published by this host.
var personServer = Config["AAuth:PersonServer"]!;
var calendar = Config["AAuth:Calendar"]!.TrimEnd('/');
using var client = AAuthClientBuilder.SelfIssuing(_identity.Key)
    .WithEgressPolicy(SampleEgress.Policy)
    .As(_identity.Issuer, _identity.AgentId)
    .WithKid(_identity.KeyId)
    .WithPersonServer(personServer)
    .WithChallengeHandling(personServer)
    .Build();
using var response = await client.GetAsync($"{calendar}/events");</code></pre>
</div>
<div class="col-md-6">
<h5>Server Code</h5>
<pre><code class="language-csharp">// One DI call: verifier, discovery clients, JTI
// store, and published metadata — no manual wiring.
builder.Services.AddAAuthResource(o =&gt;
{
    o.EgressPolicy = SampleEgress.Policy;
    o.Issuer = "https://resource.example";
    o.SigningKeys["calendar-1"] = resourceKey;
    o.ScopeDescriptions = new()
    {
        ["calendar.read"] = "See your calendar events",
    };
});
builder.Services.AddAAuthAuthentication();
builder.Services.AddAAuthAuthorization();

var app = builder.Build();

// Well-known metadata + JWKS from the DI registration.
app.MapAAuthWellKnown();

// One declarative pipeline: a single post-routing
// middleware verifies and challenges each matched
// endpoint from its metadata. Trust only the
// configured Person Servers (fail-closed).
app.UseRouting();
app.UseAAuth(o =&gt;
    o.TrustedAuthTokenIssuers = trustedPersonServers);

app.UseAuthentication();
app.UseAuthorization();

app.MapGet("/events", (HttpContext ctx) =&gt;
{
    // Middleware verified the auth token AND the
    // .RequireAAuth(...) below enforced the scope.
    var r = ctx.GetAAuthVerification()!;
    return Results.Ok(new
    {
        accessMode = "three-party",
        scheme = "jwt",
        agent = r.Agent,
        sub = r.Subject,
        scope = r.Scopes, // ["calendar.read"]
        iss = r.Issuer,
    });
})
// Per-route scope — no magic-string policies.
.RequireAAuth(scope: "calendar.read");</code></pre>
</div>
</div>


<div class="alert alert-info">
    Self-issued agent identity. Key ID: <code>@_identity.KeyId</code>
</div>

<button class="btn btn-primary" @onclick="SendRequest" disabled="@_loading">
    @(_loading ? "Sending..." : "Send Signed Request to Resource")
</button>

@if (_response is not null)
{
    <div class="mt-3">
        <h5>Response</h5>
        <div class="alert @(_success ? "alert-success" : "alert-warning")">
            <strong>@_statusCode</strong>
        </div>
        <pre><code class="language-json">@_response</code></pre>
    </div>
}

@if (_error is not null)
{
    <div class="mt-3 alert alert-danger">@_error</div>
}

@code {
    [Inject] private SelfIssuedIdentity _identity { get; set; } = default!;
    [Inject] private IConfiguration Config { get; set; } = default!;

    private bool _loading;
    private string? _response;
    private string? _error;
    private string? _statusCode;
    private bool _success;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("highlightCode");
    }

    private async Task SendRequest()
    {
        _loading = true;
        _response = null;
        _error = null;

        try
        {
            var personServer = Config["AAuth:PersonServer"]!;
            var resourceUrl = Config["AAuth:Calendar"]!;

            // Pre-grant consent so the PS issues a token immediately
            // (autonomous / direct-grant mode — no user interaction)
            await GrantConsentAsync();

            // Self-issued token refresh — no AP round-trip needed
            using var client = AAuthClientBuilder.SelfIssuing(_identity.Key).WithEgressPolicy(SampleEgress.Policy)
                .As(_identity.Issuer, _identity.AgentId)
                .WithKid(_identity.KeyId)
                .WithPersonServer(personServer)
                .WithChallengeHandling()
                .Build();

            var response = await client.GetAsync($"{resourceUrl.TrimEnd('/')}/events");

            _statusCode = $"{(int)response.StatusCode} {response.ReasonPhrase}";
            _success = response.IsSuccessStatusCode;
            var raw = await response.Content.ReadAsStringAsync();
            try { _response = System.Text.Json.JsonSerializer.Serialize(System.Text.Json.JsonDocument.Parse(raw), new System.Text.Json.JsonSerializerOptions { WriteIndented = true, Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping }); }
            catch { _response = raw; }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task GrantConsentAsync()
    {
        var personServer = Config["AAuth:PersonServer"];
        if (string.IsNullOrEmpty(personServer)) return;

        var agentId = _identity.AgentId;
        var resource = Config["AAuth:Calendar"]!;

        using var http = new SampleHttpClient();
        try
        {
            await http.PostAsJsonAsync(
                $"{personServer.TrimEnd('/')}/admin/consent",
                new { agent = agentId, resource = resource.TrimEnd('/') });
        }
        catch
        {
            // /admin/consent only exists on MockPersonServer — swallow errors
        }
    }
}
