@page "/jwt"
@using AAuth.Crypto
@using AAuth.HttpSig
@using AAuth.Tokens
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>JWT — Agent Token</PageTitle>

<h2>JWT — Agent Token (Three-Party)</h2>

<p>
    Full three-party flow: the agent enrols with an Agent Provider, then presents
    its agent token when accessing resources. The SDK acquires and refreshes the
    token lazily via a signed refresh request to the AP. Challenge handling
    automates the Person Server consent exchange.
</p>

<div class="row">
<div class="col-md-6">
<h5>Client Code</h5>
<pre><code class="language-csharp">// Enrollment (one-time provisioning)
var keyStore = KeyStore.Default();
var apClient = new AgentProviderClient(
    new HttpClient(), keyStore);
var result = await apClient.EnrolAsync(
    apBase, agentId, enrolEndpoint, personServer);

// Runtime — build signed client
var key = await keyStore.LoadAsync(result.LocalKeyHandle);

using var client = new AAuthClientBuilder(key)
    .WithTokenRefresh(async (ctx, ct) =>
    {
        var ap = new AgentProviderClient(
            new HttpClient(), keyStore);
        return await ap.RefreshAsync(
            refreshEndpoint, localKeyHandle, ct);
    })
    .WithChallengeHandling(personServer)
    .Build();</code></pre>
</div>
<div class="col-md-6">
<h5>Server Code</h5>
<pre><code class="language-csharp">builder.Services.AddSingleton(new AAuthVerifier());
builder.Services.AddSingleton(sp =&gt;
    new MetadataClient(httpClient));
builder.Services.AddSingleton(sp =&gt;
    new JwksClient(httpClient));

var app = builder.Build();

// Middleware verifies HTTP signature AND the
// JWT issuer (via JWKS discovery), then stores
// the result in HttpContext.Features.
app.UseAAuthVerification(new AAuthVerificationOptions
{
    ResourceIdentifier = "https://resource.example",
    RequireIssuerVerification = true,
});

// Auto-challenge: returns 401 with a resource
// token if only an agent token is presented.
// On retry the PS provides an auth token.
app.UseAAuthChallenge(new ChallengeOptions
{
    AccessMode = AAuthAccessMode.RequireAuthToken,
});

app.MapGet("/", (HttpContext ctx) =&gt;
{
    // Middleware already verified the auth token.
    // Claims are available via Features:
    var r = ctx.Features
        .Get&lt;AAuthVerificationResult&gt;()!;
    return Results.Ok(new
    {
        mode = "three-party",
        agent = r.Agent,
        sub = r.Subject,
        scope = r.Scopes,
        iss = r.Issuer,
    });
});</code></pre>
</div>
</div>


<div class="alert alert-info">
    Self-issued agent identity. Key ID: <code>@_identity.KeyId</code>
</div>

<button class="btn btn-primary" @onclick="SendRequest" disabled="@_loading">
    @(_loading ? "Sending..." : "Send Signed Request to Resource")
</button>

@if (_response is not null)
{
    <div class="mt-3">
        <h5>Response</h5>
        <div class="alert @(_success ? "alert-success" : "alert-warning")">
            <strong>@_statusCode</strong>
        </div>
        <pre><code class="language-json">@_response</code></pre>
    </div>
}

@if (_error is not null)
{
    <div class="mt-3 alert alert-danger">@_error</div>
}

@code {
    [Inject] private SelfIssuedIdentity _identity { get; set; } = default!;
    [Inject] private IConfiguration Config { get; set; } = default!;

    private bool _loading;
    private string? _response;
    private string? _error;
    private string? _statusCode;
    private bool _success;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("highlightCode");
    }

    private async Task SendRequest()
    {
        _loading = true;
        _response = null;
        _error = null;

        try
        {
            var personServer = Config["AAuth:PersonServer"]!;
            var resourceUrl = Config["AAuth:Resource"]!;

            // Pre-grant consent so the PS issues a token immediately
            // (autonomous / direct-grant mode — no user interaction)
            await GrantConsentAsync();

            // Self-issued token refresh — no AP round-trip needed
            using var client = new AAuthClientBuilder(_identity.Key)
                .WithTokenRefresh(async (ctx, ct) =>
                {
                    return new AgentTokenBuilder
                    {
                        Issuer = _identity.Issuer,
                        Subject = _identity.AgentId,
                        KeyId = _identity.KeyId,
                        Key = _identity.Key,
                        PersonServer = personServer,
                    }.Build();
                })
                .WithChallengeHandling(personServer)
                .Build();

            var response = await client.GetAsync(resourceUrl);

            _statusCode = $"{(int)response.StatusCode} {response.ReasonPhrase}";
            _success = response.IsSuccessStatusCode;
            var raw = await response.Content.ReadAsStringAsync();
            try { _response = System.Text.Json.JsonSerializer.Serialize(System.Text.Json.JsonDocument.Parse(raw), new System.Text.Json.JsonSerializerOptions { WriteIndented = true, Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping }); }
            catch { _response = raw; }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task GrantConsentAsync()
    {
        var personServer = Config["AAuth:PersonServer"];
        if (string.IsNullOrEmpty(personServer)) return;

        var agentId = _identity.AgentId;
        var resource = Config["AAuth:Resource"]!;

        using var http = new HttpClient();
        try
        {
            await http.PostAsJsonAsync(
                $"{personServer.TrimEnd('/')}/admin/consent",
                new { agent = agentId, resource = resource.TrimEnd('/') });
        }
        catch
        {
            // /admin/consent only exists on MockPersonServer — swallow errors
        }
    }
}
