{
  "realm": "aauth",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      {
        "name": "wallet.payer",
        "description": "Grants the elevated wallet.charge scope at the Access Server."
      }
    ]
  },
  "groups": [
    {
      "name": "demo-users",
      "realmRoles": []
    }
  ],
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Admin",
      "email": "demo@aauth.example",
      "credentials": [
        {
          "type": "password",
          "value": "demo",
          "temporary": false
        }
      ],
      "realmRoles": [
        "wallet.payer"
      ],
      "groups": [
        "/demo-users"
      ]
    },
    {
      "username": "guest",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Guest",
      "lastName": "User",
      "email": "guest@aauth.example",
      "credentials": [
        {
          "type": "password",
          "value": "guest",
          "temporary": false
        }
      ],
      "realmRoles": [],
      "groups": [
        "/demo-users"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "aauth-access-server",
      "name": "AAuth Access Server",
      "description": "Confidential client the .NET AS adapter authenticates as; hosts the Wallet authorization resource and policies.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "aauth-access-server-secret",
      "clientAuthenticatorType": "client-secret",
      "consentRequired": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": true,
      "redirectUris": [
        "http://localhost:5500/interaction/callback",
        "http://localhost:5500/*"
      ],
      "webOrigins": [
        "http://localhost:5500"
      ],
      "fullScopeAllowed": true,
      "authorizationSettings": {
        "allowRemoteResourceManagement": true,
        "policyEnforcementMode": "ENFORCING",
        "decisionStrategy": "AFFIRMATIVE",
        "resources": [
          {
            "name": "wallet",
            "displayName": "Wallet resource",
            "ownerManagedAccess": false,
            "scopes": [
              { "name": "wallet.read" },
              { "name": "wallet.charge" }
            ]
          }
        ],
        "scopes": [
          { "name": "wallet.read" },
          { "name": "wallet.charge" }
        ],
        "policies": [
          {
            "name": "any-authenticated-client",
            "description": "Always satisfied for requests made by the Access Server adapter client (i.e. any authenticated user).",
            "type": "client",
            "logic": "POSITIVE",
            "decisionStrategy": "AFFIRMATIVE",
            "config": {
              "clients": "[\"aauth-access-server\"]"
            }
          },
          {
            "name": "wallet-payer-role",
            "description": "Requires the realm role wallet.payer.",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\":\"wallet.payer\",\"required\":true}]"
            }
          },
          {
            "name": "wallet-read-permission",
            "description": "Base wallet.read scope: any authenticated user.",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "AFFIRMATIVE",
            "config": {
              "resources": "[\"wallet\"]",
              "scopes": "[\"wallet.read\"]",
              "applyPolicies": "[\"any-authenticated-client\"]"
            }
          },
          {
            "name": "wallet-charge-permission",
            "description": "Elevated wallet.charge scope: requires the wallet.payer role.",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"wallet\"]",
              "scopes": "[\"wallet.charge\"]",
              "applyPolicies": "[\"wallet-payer-role\"]"
            }
          }
        ]
      }
    }
  ]
}
