@namespace AAuth.Samples.Capabilities
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Configuration
@using System.Text.Json
@using AAuth.Samples.Shared
@inject IConfiguration Configuration
@implements IDisposable

<section class="catalog-view @(GuidedTour ? "guided-tour-flow" : null)" aria-label="Catalog gateway walkthrough" data-step="@_session.Step">
    <SyntaxHighlight Trigger="_session.Step" />
    <header><h1>Travel Catalog Gateway</h1><output>@_session.Step / 5 complete</output></header>
    <details class="scenario-narrative" open>
        <summary>📖 What Aria is trying to do</summary>
        <p>
            Aria is comparing where to go and what to do there. One travel gateway fronts
            a <strong>Destinations</strong> catalog and an <strong>Experiences</strong>
            catalog, and both expose an operation called <code>list</code>.
        </p>
        <p>
            The grant must therefore identify the service as well as the operation. This
            walkthrough authorizes one catalog, proves that the sibling catalog rejects
            that grant, then obtains the correctly qualified authorization.
        </p>
    </details>
    <label for="catalog-service">Catalog service</label>
    <select id="catalog-service" @bind="_session.Service" disabled="@(_busy || _session.Step > 0)">
        <option value="destinations">Destinations</option><option value="experiences">Experiences</option>
    </select>
    <div class="catalog-actions">
        <button class="catalog-next" @onclick="Next" disabled="@(!_interactive || _busy || _session.Step == 5)">
            <img src="_content/EventSupport/arrow-right.svg" width="18" height="18" alt="" />
            @(_busy ? "Awaiting response" : _session.Step == 5 ? "Completed" : CatalogDemoSession.Steps[_session.Step])
        </button>
        <button @onclick="Reset" disabled="@_busy" aria-label="Reset catalog flow" title="Reset catalog flow">
            <img src="_content/EventSupport/rotate-ccw.svg" width="18" height="18" alt="" />
        </button>
    </div>
    @if (_session.ConsentUrl is { } consent) { <a class="catalog-consent" href="@consent" target="_blank" rel="noopener">Review catalog authorization</a> }
    @if (_error is not null) { <p role="alert">@_error</p> }
    <div class="tour-sequence-layout">
        <ol class="catalog-steps" aria-label="Protocol steps">
            @for (var index = 0; index < CatalogDemoSession.Steps.Length; index++)
            {
                <li aria-current="@(index == _session.Step ? "step" : null)">@CatalogDemoSession.Steps[index]</li>
            }
        </ol>
        <div class="tour-diagram"><ProtocolSequence Participants="CatalogParticipants" Messages="CatalogSequence" CompletedSteps="_session.Step" ShowPendingMessages="@(!GuidedTour)" /></div>
        @if (GuidedTour)
        {
            <section class="tour-payload" aria-label="Selected step payload">
                @if (_session.Result is { } payload)
                {
                    <h2>Step @_session.Step result</h2><pre>@payload</pre>
                }
                else
                {
                    <p class="hint">Run a step to see its payloads here.</p>
                }
            </section>
        }
    </div>
    @if (_session.Result is { } result) { <pre data-testid="catalog-result" class="@(GuidedTour ? "tour-result-source" : null)">@result</pre> }
    <section aria-label="Recorded exchanges">
        @foreach (var exchange in _session.Exchanges)
        {
            <details open class="catalog-exchange" data-status="@exchange.Status"><summary>@exchange.Method @exchange.Url HTTP @exchange.Status</summary>
                <pre>@JsonSerializer.Serialize(exchange, WalletDemoSession.Pretty)</pre></details>
        }
    </section>
    <details open class="catalog-code"><summary>C# service-qualified enforcement</summary><pre><code class="language-csharp">@Example</code></pre></details>
</section>

@code {
    [Parameter] public bool GuidedTour { get; set; }

    private static readonly ProtocolParticipant[] CatalogParticipants =
    [
        new("agent", "Agent"), new("ap", "Agent Provider"), new("catalog", "Catalog"),
        new("ps", "Person Server"), new("as", "R3 Access Server"),
    ];
    private static readonly ProtocolMessage[] CatalogSequence =
    [
        ProtocolMessage.Http(1, "network", "agent", "catalog", "Discover gateway services", responseLabel: "200"),
        ProtocolMessage.Http(1, "setup", "agent", "ap", "Enroll and receive agent JWT", responseLabel: "200"),
        ProtocolMessage.Http(2, "network", "agent", "catalog", "Request selected catalog; receive challenge", responseLabel: "401"),
        ProtocolMessage.Http(2, "network", "agent", "ps", "Exchange selected-service resource token", "200"),
        ProtocolMessage.Http(2, "network", "ps", "as", "Federate service-qualified authorization", "200"),
        ProtocolMessage.Http(2, "network", "as", "catalog", "Fetch and verify the R3 definition", responseLabel: "200"),
        ProtocolMessage.Http(3, "network", "agent", "catalog", "Read selected catalog", responseLabel: "200"),
        ProtocolMessage.Http(4, "network", "agent", "catalog", "Sibling service rejects mismatched grant", responseLabel: "403"),
        ProtocolMessage.Http(5, "network", "agent", "catalog", "Request sibling-service challenge", responseLabel: "401"),
        ProtocolMessage.Http(5, "network", "agent", "ps", "Exchange sibling-service resource token", "200"),
        ProtocolMessage.Http(5, "network", "ps", "as", "Authorize the qualified sibling operation", "200"),
        ProtocolMessage.Http(5, "network", "agent", "catalog", "Read sibling catalog with fresh grant", responseLabel: "200"),
    ];
    public const string Example = """
        public static R3EnforcementDecision AuthorizeCatalog(R3Enforcement enforcement,
            JsonObject verifiedAuthToken, string service)
            => enforcement.Evaluate(verifiedAuthToken,
                new R3OperationIdentity(Vocabulary.OpenApiGateway, R3Operation.OpenApiGateway(service, "list")));
        """;
    private CatalogDemoSession _session = null!;
    private readonly CancellationTokenSource _cancellation = new();
    private bool _busy;
    private bool _interactive;
    private string? _error;
    protected override void OnInitialized() => Create();
    protected override void OnAfterRender(bool firstRender) { if (firstRender) { _interactive = true; StateHasChanged(); } }
    private void Create(string service = "destinations")
    {
        _session = new(Configuration["AAuth:AgentProvider"] ?? "http://localhost:5301",
            Configuration["AAuth:PersonServer"] ?? "http://localhost:5100", Configuration["AAuth:Catalog"] ?? "http://localhost:5006") { Service = service };
        _session.Changed = () => InvokeAsync(StateHasChanged);
    }
    private async Task Next()
    {
        _busy = true; _error = null;
        try { await _session.NextAsync(_cancellation.Token); }
        catch (Exception exception) when (exception is not OperationCanceledException) { _error = exception.Message; }
        finally { _busy = false; }
    }
    private void Reset() { var service = _session.Service; _session.Dispose(); Create(service); _error = null; }
    public void Dispose() { _cancellation.Cancel(); _cancellation.Dispose(); _session.Dispose(); }
}