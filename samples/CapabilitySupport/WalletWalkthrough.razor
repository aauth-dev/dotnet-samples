@namespace AAuth.Samples.Capabilities
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Configuration
@using System.Text.Json
@using AAuth.Samples.Shared
@inject IConfiguration Configuration
@inject AAuth.Agent.IAAuthAgentFactory Agents

@code {
    /// <summary>The Person Server; defaults to <c>AAuth:PersonServer</c>.</summary>
    [Parameter] public string? PersonServer { get; set; }

    private string PersonServerUrl => PersonServer ?? Configuration["AAuth:PersonServer"] ?? "http://localhost:5100";
}
@implements IDisposable

<section class="wallet-walkthrough" aria-label="Wallet protocol walkthrough" data-step="@_session.Step" data-flow="@_session.Flow">
    <SyntaxHighlight Trigger="@((_session.Flow, _session.Step))" />
    <header><h1>Wallet Protocol</h1><output aria-live="polite">@_session.Step / @_session.Steps.Length complete</output></header>
    <details class="scenario-narrative" open>
        <summary>📖 What Aria is trying to do</summary>
        <p>
            Aria is finalizing a trip and needs to use your <strong>Wallet</strong> safely.
            Depending on what happens, it may need to explain the purchase to the Access
            Server, let Concierge extend an existing authorization, or recover after you
            revoke a grant.
        </p>
        <p>
            Choose one scenario below. Each starts from Aria's signed request and shows
            which authority makes the next decision, what is sent over the wire, and why
            a denied, cancelled, or revoked grant cannot be silently reused.
        </p>
    </details>
    <label for="wallet-flow">Flow</label>
    <select id="wallet-flow" @bind="_session.Flow" disabled="@(_busy || _session.Step > 0)">
        <option value="Clarification">AS clarification</option>
        <option value="AsGrantChaining">Chaining an AS-issued grant</option>
        <option value="Revocation">Federated revocation</option>
    </select>
    <div class="wallet-actions">
        <button class="wallet-next" disabled="@(!_interactive || _busy || _session.Cancelled || _session.Step == _session.Steps.Length)" @onclick="Next">
            <img src="_content/EventSupport/arrow-right.svg" width="18" height="18" alt="" />
            @(_busy ? "Awaiting response" : _session.Step == _session.Steps.Length ? "Completed" : _session.Steps[_session.Step])
        </button>
        <button disabled="@_busy" @onclick="Reset" aria-label="Reset wallet flow" title="Reset wallet flow">
            <img src="_content/EventSupport/rotate-ccw.svg" width="18" height="18" alt="" />
        </button>
    </div>
    @if (_session.Question is { } question)
    {
        <section class="wallet-question" aria-label="AS clarification">
            <h2>Access Server clarification</h2><p>@question</p>
            <label for="wallet-answer">Justification</label>
            <textarea id="wallet-answer" @bind="_answer"></textarea>
            <button @onclick="() => _session.Answer(_answer)" disabled="@string.IsNullOrWhiteSpace(_answer)">Send answer</button>
            <button @onclick="_session.Cancel">Cancel request</button>
        </section>
    }
    @if (_session.Consent is { } consent)
    {
        <aside role="status">
            <ConsentSupport.PersonServerApprovalPrompt PersonServer="@PersonServerUrl" Interaction="consent" LinkClass="wallet-consent"
                                                       ExternalLabel="Review authorization" />
        </aside>
    }
    @if (_error is not null) { <p role="alert">@_error</p> }
    @if (_session.Cancelled) { <p role="status" data-testid="wallet-cancelled">Request cancelled. No auth token was issued.</p> }
    <ol class="wallet-steps" aria-label="Protocol steps">
        @for (var index = 0; index < _session.Steps.Length; index++)
        {
            <li class="@(index < _session.Step ? "complete" : index == _session.Step ? "current" : "")"
                aria-current="@(index == _session.Step ? "step" : null)">@_session.Steps[index]</li>
        }
    </ol>
    <ProtocolSequence Participants="WalletParticipants" Messages="WalletSequence" CompletedSteps="_session.Step" />
    @if (_session.Result is { } result)
    {
        <section aria-label="Step result"><h2>Step @_session.Step result</h2><pre data-testid="wallet-result">@result</pre></section>
    }
    <section aria-label="Recorded exchanges">
        @foreach (var exchange in _session.Exchanges)
        {
            <details class="wallet-exchange" data-status="@exchange.Status" open>
                <summary>@exchange.Method @exchange.Url <strong>HTTP @exchange.Status</strong></summary>
                <pre>@JsonSerializer.Serialize(exchange, WalletDemoSession.Pretty)</pre>
            </details>
        }
    </section>
    <details class="wallet-code" open data-flow="@_session.Flow" data-step="@_session.Step">
        <summary>C# @_session.Flow</summary><pre><code @key="_session.Flow" class="language-csharp">@WalletScenarioCode.For(_session.Flow)</code></pre>
    </details>
</section>

@code {
    private static readonly ProtocolParticipant[] ClarificationParticipants =
    [
        new("agent", "Agent"), new("ap", "Agent Provider"), new("wallet", "Wallet"),
        new("ps", "Person Server"), new("as", "Access Server"), new("user", "User / Browser"),
    ];
    private static readonly ProtocolMessage[] ClarificationSequence =
    [
        ProtocolMessage.Http(1, "setup", "agent", "ap", "Enroll and receive agent JWT", responseLabel: "200"),
        ProtocolMessage.Http(2, "network", "agent", "ps", "Obtain Wallet person token", responseLabel: "200"),
        ProtocolMessage.Http(2, "network", "agent", "wallet", "Request wallet review; receive challenge", responseLabel: "401"),
        ProtocolMessage.Http(3, "network", "agent", "ps", "Exchange Wallet resource token", "202/200"),
        ProtocolMessage.Http(3, "network", "ps", "as", "Federate review authorization", "202/200"),
        ProtocolMessage.Signal(3, "as", "agent", "Ask why the review is needed"),
        ProtocolMessage.Signal(3, "agent", "as", "Return clarification answer"),
        ProtocolMessage.Http(3, "network", "user", "as", "Approve the clarified request", responseLabel: "200"),
        ProtocolMessage.Http(4, "network", "agent", "wallet", "Read approved wallet review", responseLabel: "200"),
        ProtocolMessage.Http(5, "network", "agent", "wallet", "Reject charge outside the grant", responseLabel: "403"),
    ];
    private static readonly ProtocolParticipant[] ChainingParticipants =
    [
        new("agent", "Agent"), new("ap", "Agent Provider"), new("concierge", "Concierge"),
        new("wallet", "Wallet"), new("ps", "Person Server"), new("as", "Access Server"),
        new("user", "User / Browser"),
    ];
    private static readonly ProtocolMessage[] ChainingSequence =
    [
        ProtocolMessage.Http(1, "setup", "agent", "ap", "Enroll and receive agent JWT", responseLabel: "200"),
        ProtocolMessage.Http(2, "network", "agent", "ps", "Obtain Concierge person token", responseLabel: "200"),
        ProtocolMessage.Http(2, "network", "agent", "concierge", "Request delegated Wallet access", responseLabel: "401"),
        ProtocolMessage.Http(3, "network", "agent", "ps", "Exchange upstream resource token", "202/200"),
        ProtocolMessage.Http(3, "network", "ps", "as", "Federate upstream authorization", "202/200"),
        ProtocolMessage.Http(3, "network", "user", "as", "Approve upstream grant", responseLabel: "200"),
        ProtocolMessage.Http(4, "network", "agent", "concierge", "Present upstream grant", "202/200"),
        ProtocolMessage.Http(4, "network", "concierge", "ps", "Exchange with upstream_token at the person's PS", "202/200"),
        ProtocolMessage.Http(4, "network", "user", "ps", "Approve the chained Wallet grant", responseLabel: "200"),
        ProtocolMessage.Http(4, "network", "ps", "as", "Federate Wallet authorization", "200"),
        ProtocolMessage.Http(4, "network", "concierge", "wallet", "Read Wallet with delegated grant", responseLabel: "200"),
        ProtocolMessage.Http(5, "network", "agent", "wallet", "Reject upstream token at Wallet", responseLabel: "401"),
        ProtocolMessage.Http(6, "network", "agent", "concierge", "Repeat delegated Wallet read", responseLabel: "200"),
    ];
    private static readonly ProtocolParticipant[] RevocationParticipants =
    [
        new("agent", "Agent"), new("ap", "Agent Provider"), new("wallet", "Wallet"),
        new("ps", "Person Server"), new("as", "Access Server"), new("user", "User / Browser"),
    ];
    private static readonly ProtocolMessage[] RevocationSequence =
    [
        ProtocolMessage.Http(1, "setup", "agent", "ap", "Enroll and receive agent JWT", responseLabel: "200"),
        ProtocolMessage.Http(2, "network", "agent", "ps", "Obtain Wallet person token", responseLabel: "200"),
        ProtocolMessage.Http(2, "network", "agent", "wallet", "Request Wallet access", responseLabel: "401"),
        ProtocolMessage.Http(3, "network", "agent", "ps", "Exchange Wallet resource token", "202/200"),
        ProtocolMessage.Http(3, "network", "ps", "as", "Federate with the presented person token", "202/200"),
        ProtocolMessage.Http(3, "network", "user", "ps", "Approve Wallet grant", responseLabel: "200"),
        ProtocolMessage.Http(4, "network", "agent", "wallet", "Read Wallet", responseLabel: "200"),
        ProtocolMessage.Http(5, "network", "agent", "wallet", "Reject agent as revoker", responseLabel: "403"),
        ProtocolMessage.Http(6, "network", "agent", "ps", "Ask the PS to end federated access", responseLabel: "200"),
        ProtocolMessage.Http(6, "network", "ps", "as", "Revoke presented person token by {jti, exp}", responseLabel: "200"),
        ProtocolMessage.Http(6, "network", "as", "wallet", "Cascade: revoke AS auth token by {jti, exp}", responseLabel: "200"),
        ProtocolMessage.Http(7, "network", "agent", "wallet", "Reject revoked grant", responseLabel: "401"),
        ProtocolMessage.Http(8, "network", "agent", "wallet", "Request fresh challenge", responseLabel: "401"),
        ProtocolMessage.Http(8, "network", "agent", "ps", "Obtain fresh grant", "202/200"),
        ProtocolMessage.Http(8, "network", "agent", "wallet", "Recover Wallet access", responseLabel: "200"),
    ];
    private IReadOnlyList<ProtocolParticipant> WalletParticipants => _session.Flow switch
    {
        WalletFlow.AsGrantChaining => ChainingParticipants,
        WalletFlow.Revocation => RevocationParticipants,
        _ => ClarificationParticipants,
    };
    private IReadOnlyList<ProtocolMessage> WalletSequence => _session.Flow switch
    {
        WalletFlow.AsGrantChaining => ChainingSequence,
        WalletFlow.Revocation => RevocationSequence,
        _ => ClarificationSequence,
    };
    private WalletDemoSession _session = null!;
    private readonly CancellationTokenSource _cancellation = new();
    private bool _busy;
    private bool _interactive;
    private string _answer = "Compare the available travel budget.";
    private string? _error;
    protected override void OnInitialized() => Create();
    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        _interactive = true;
        StateHasChanged();
    }
    private void Create(WalletFlow flow = WalletFlow.Clarification)
    {
        _session = new(Agents, Configuration["AAuth:AgentProvider"] ?? "http://localhost:5301",
            PersonServerUrl,
            Configuration["AAuth:Wallet"] ?? "http://localhost:5003",
            Configuration["AAuth:Concierge"] ?? "http://localhost:5200") { Flow = flow };
        _session.Changed = () => InvokeAsync(StateHasChanged);
    }
    private async Task Next()
    {
        _busy = true; _error = null;
        try { await _session.NextAsync(_cancellation.Token); }
        catch (Exception exception) when (exception is not OperationCanceledException) { _error = exception.Message; }
        finally { _busy = false; }
    }
    private void Reset()
    {
        var flow = _session.Flow;
        _session.Dispose(); Create(flow); _error = null;
    }
    public void Dispose() { _cancellation.Cancel(); _cancellation.Dispose(); _session.Dispose(); }
}