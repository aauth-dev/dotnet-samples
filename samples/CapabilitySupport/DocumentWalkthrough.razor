@namespace AAuth.Samples.Capabilities
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Configuration
@using System.Text.Json
@using AAuth.Samples.Shared
@inject IConfiguration Configuration
@inject AAuth.Agent.IAAuthAgentFactory Agents

@code {
    /// <summary>The Person Server; defaults to <c>AAuth:PersonServer</c>.</summary>
    [Parameter] public string? PersonServer { get; set; }

    private string PersonServerUrl => PersonServer ?? Configuration["AAuth:PersonServer"] ?? "http://localhost:5100";
}
@implements IDisposable

<section class="document-view" aria-label="Document release walkthrough" data-step="@_session.Step">
    <SyntaxHighlight Trigger="_session.Step" />
    <header><h1>Document Release</h1><output>@_session.Step / 4 complete</output></header>
    <details class="scenario-narrative" open>
        <summary>📖 What Aria is trying to do</summary>
        <p>
            Aria needs a work travel brief from <strong>Documents</strong> to finish your
            itinerary. The document owner must first decide that this specific file may be
            released; only then may your Person Server ask you to authorize the download.
        </p>
        <p>
            This ordering prevents person consent from overriding the resource owner's
            decision. Try both approval and denial to see that no auth token or document is
            released when either authority says no.
        </p>
    </details>
    <div class="document-actions">
        <button class="document-next" @onclick="Next" disabled="@(!_interactive || _busy || _session.Denied || _session.Step == 4)">
            <img src="_content/EventSupport/arrow-right.svg" width="18" height="18" alt="" />
            @(_busy ? "Awaiting authorization" : _session.Step == 4 ? "Completed" : DocumentDemoSession.Steps[_session.Step])
        </button>
        <button @onclick="Reset" disabled="@_busy" title="Reset document flow" aria-label="Reset document flow"><img src="_content/EventSupport/rotate-ccw.svg" width="18" height="18" alt="" /></button>
    </div>
    @if (_session.Consent is { } consent)
    {
        <ConsentSupport.PersonServerApprovalPrompt PersonServer="@PersonServerUrl" Interaction="consent" LinkClass="document-consent"
                                                   ExternalLabel="Review document authorization" />
    }
    @if (_session.Denied) { <p data-testid="document-denied">Document release declined. No authorization issued.</p> }
    @if (_error is not null) { <p role="alert">@_error</p> }
    <ol aria-label="Protocol steps">
        @for (var index = 0; index < DocumentDemoSession.Steps.Length; index++)
        {
            <li data-protocol-step="@(index + 1)" aria-current="@(index == _session.Step ? "step" : null)">@DocumentDemoSession.Steps[index]</li>
        }
    </ol>
    <ProtocolSequence Participants="DocumentParticipants" Messages="Sequence" CompletedSteps="_session.Step" />
    @if (_session.Result is { } result) { <pre data-testid="document-result">@result</pre> }
    <section aria-label="Recorded exchanges">
        @foreach (var exchange in _session.Exchanges)
        {
            <details open class="document-exchange" data-status="@exchange.Status"><summary>@exchange.Method @exchange.Url HTTP @exchange.Status</summary>
                <pre>@JsonSerializer.Serialize(exchange, WalletDemoSession.Pretty)</pre></details>
        }
    </section>
    @for (var index = 0; index < Examples.Length; index++)
    {
        <details class="document-code" data-code-step="@(index + 1)" open="@(index == Math.Min(_session.Step, 3))">
            <summary>@(index + 1). @DocumentDemoSession.Steps[index] (C#)</summary>
            <pre><code class="language-csharp">@Examples[index]</code></pre>
        </details>
    }
</section>

@code {
    private static readonly ProtocolParticipant[] DocumentParticipants =
    [
        new("agent", "Agent"), new("ap", "Agent Provider"), new("resource", "Documents"),
        new("browser", "User / Browser"), new("ps", "Person Server"),
    ];
    private static readonly ProtocolMessage[] Sequence =
    [
        ProtocolMessage.Http(1, "setup", "agent", "ap", "Enroll and receive agent JWT", responseLabel: "200"),
        ProtocolMessage.Http(2, "network", "agent", "resource", "Request document; receive resource token", responseLabel: "401"),
        ProtocolMessage.Http(2, "network", "agent", "resource", "Discover metadata and JWKS", responseLabel: "200"),
        ProtocolMessage.Local(2, "agent", "Verify token and request binding"),
        ProtocolMessage.Http(3, "network", "agent", "ps", "Exchange resource token; receive pending URL", responseLabel: "202"),
        ProtocolMessage.Http(3, "network", "browser", "ps", "Open resource-permission interstitial", responseLabel: "200"),
        ProtocolMessage.Http(3, "network", "browser", "resource", "Submit document-owner decision", responseLabel: "302"),
        ProtocolMessage.Http(3, "network", "browser", "ps", "Submit person consent decision", responseLabel: "200"),
        ProtocolMessage.Http(3, "network", "agent", "ps", "Poll pending grant", responseLabel: "200"),
        ProtocolMessage.Http(4, "network", "agent", "resource", "Download released document", responseLabel: "200"),
    ];
    public static readonly string[] Examples = [EnrollExample, ChallengeExample, AuthorizeExample, DownloadExample];
    public const string EnrollExample = """
        public static async Task<EnrollResult> EnrollDocumentAgentAsync(
            AAuthKey key, IKeyStore keyStore, string provider, string person,
            AAuthEgressPolicy policy, CancellationToken cancellationToken)
            => await AAuthClientBuilder.Bootstrap(provider + "/enrol")
                .WithKey(key).WithKeyStore(keyStore).WithPersonServer(person)
                .WithEgressPolicy(policy).EnrolAsync(cancellationToken);
        """;
    public const string ChallengeExample = """
        public static async Task<string> RequestDocumentAsync(AAuthAgent agent,
            string resource, string person, IAAuthSigner key,
            TokenVerifier verifier, MetadataClient metadata, JwksClient jwks,
            AAuthEgressPolicy policy, CancellationToken cancellationToken)
        {
            // The resource first asks who the agent acts for (requirement=person-token).
            var personToken = await agent.TokenExchange
                .RequestPersonTokenAsync(person, resource, cancellationToken);
            using var personClient = new AAuthClientBuilder(key).UseJwt(personToken)
                .WithEgressPolicy(policy).Build();
            using var request = new HttpRequestMessage(HttpMethod.Get, resource + "/document");
            request.Options.Set(AAuthRequestOptions.Account, "work");
            using var response = await personClient.SendAsync(request, cancellationToken);
            if (response.StatusCode != HttpStatusCode.Unauthorized)
                throw new InvalidOperationException("Expected document challenge.");
            var token = AAuthRequirementHeader.Parse(response.Headers
                .GetValues(AAuthRequirementHeader.Name).Single()).ResourceToken!;
            var verified = await verifier.VerifyResourceTokenAsync(token, person,
                key.ComputeJwkThumbprint(), metadata, jwks, expectedPersonServer: person,
                cancellationToken: cancellationToken);
            if (verified.Issuer != resource || verified.Account != "work")
                throw new TokenVerificationException("Document request context mismatch.");
            return token;
        }
        """;
    public const string AuthorizeExample = """
        public static Task<string> AuthorizeDocumentAsync(AAuthAgent agent,
            string person, string resourceToken, string personToken,
            Func<Interaction, CancellationToken, Task> showConsent,
            CancellationToken cancellationToken)
            // The agent's TokenExchange client is signed as the agent, never with a carrier token.
            => agent.TokenExchange.ExchangeAsync(person,
                resourceToken, new TokenExchangeRequest
                {
                    PresentedToken = personToken,
                    Account = "work",
                    OnInteractionRequired = showConsent,
                    PollerOptions = new DeferredPollerOptions { MaxTotalWait = TimeSpan.FromMinutes(5) },
                }, cancellationToken);
        """;
    public const string DownloadExample = """
        public static async Task<string> DownloadDocumentAsync(IAAuthSigner key,
            string authToken, string resource, AAuthEgressPolicy policy,
            CancellationToken cancellationToken)
        {
            using var authorized = new AAuthClientBuilder(key).UseJwt(authToken)
                .WithEgressPolicy(policy).Build();
            using var response = await authorized.GetAsync(resource + "/document", cancellationToken);
            response.EnsureSuccessStatusCode();
            return await response.Content.ReadAsStringAsync(cancellationToken);
        }
        """;
    private DocumentDemoSession _session = null!;
    private readonly CancellationTokenSource _cancellation = new();
    private bool _busy;
    private bool _interactive;
    private string? _error;
    protected override void OnInitialized() => Create();
    protected override void OnAfterRender(bool firstRender) { if (firstRender) { _interactive = true; StateHasChanged(); } }
    private void Create()
    {
        _session = new(Agents, Configuration["AAuth:AgentProvider"] ?? "http://localhost:5301",
            PersonServerUrl, Configuration["AAuth:Documents"] ?? "http://localhost:5007");
        _session.Changed = () => InvokeAsync(StateHasChanged);
    }
    private async Task Next()
    {
        _busy = true; _error = null;
        try { await _session.NextAsync(_cancellation.Token); }
        catch (Exception exception) when (exception is not OperationCanceledException) { _error = exception.Message; }
        finally { _busy = false; }
    }
    private void Reset() { _session.Dispose(); Create(); _error = null; }
    public void Dispose() { _cancellation.Cancel(); _cancellation.Dispose(); _session.Dispose(); }
}