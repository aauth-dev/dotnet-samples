@namespace AAuth.Samples.Events
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Configuration
@using AAuth.Samples.Shared
@inject IConfiguration Configuration

@code {
    private string PersonServerUrl => Configuration["AAuth:PersonServer"] ?? "http://localhost:5100";
}
@implements IDisposable

<section class="events-view" aria-label="Events walkthrough" data-step="@_session.Step" data-channel="@(_session.Protected ? "protected" : "public")">
    <SyntaxHighlight Trigger="_session.Step" />
    <header class="events-heading">
        <img src="_content/EventSupport/bell.svg" alt="" width="28" height="28" />
        <h1>Bookings Events</h1>
        <span class="events-count" aria-live="polite">@_session.Step / 6 complete</span>
    </header>
    <details class="scenario-narrative" open>
        <summary>📖 What Aria is trying to do</summary>
        <p>
            A reservation you wanted was unavailable, so Aria asks
            <strong>Bookings</strong> to notify it when a place opens. Because an agent
            cannot receive a public webhook, its Agent Provider acts as a durable inbox.
        </p>
        <p>
            Use the public channel for general availability, or the protected channel for
            your Work or Personal reservations. Aria registers a signed subscription,
            verifies the resource's event, ignores a duplicate, and acknowledges receipt.
        </p>
    </details>
    <div class="events-options">
        <fieldset disabled="@(!_interactive || _busy || _session.Step > 0)">
            <legend>Subscription channel</legend>
            <label><input type="radio" name="events-channel" checked="@_session.Protected" @onchange="() => _session.Protected = true" /> Protected reservations</label>
            <label><input type="radio" name="events-channel" checked="@(!_session.Protected)" @onchange="() => _session.Protected = false" /> Public availability</label>
        </fieldset>
        <label for="events-account">Account
            <select id="events-account" @bind="_session.Account" disabled="@(_busy || _session.Step > 0 || !_session.Protected)">
                <option value="personal">Personal reservations</option>
                <option value="work">Work reservations</option>
            </select>
        </label>
    </div>
    <div class="events-actions">
        <button type="button" class="events-next" disabled="@(!_interactive || _busy || _session.Step == 6)" @onclick="Next">
            <img src="_content/EventSupport/arrow-right.svg" width="18" height="18" alt="" />
            @(_busy ? "Awaiting response" : _session.Step == 6 ? "Completed" : EventDemoSession.Steps[_session.Step])
        </button>
        <button type="button" disabled="@_busy" @onclick="Reset" title="Start a new subscription" aria-label="Start a new subscription">
            <img src="_content/EventSupport/rotate-ccw.svg" width="18" height="18" alt="" />
        </button>
    </div>
    @if (_session.Consent is { } consent)
    {
        <aside class="events-consent" role="status">
            <h2>Person Server consent</h2>
            <ConsentSupport.PersonServerApprovalPrompt PersonServer="@PersonServerUrl" Interaction="consent" LinkClass="events-consent-action"
                                                       ExternalLabel="Open account authorization" />
        </aside>
    }
    @if (_error is not null)
    {
        <p class="events-error" role="alert">@_error</p>
    }
    <ol class="events-sequence" aria-label="Protocol steps">
        @for (var index = 0; index < EventDemoSession.Steps.Length; index++)
        {
            <li class="@(index < _session.Step ? "complete" : index == _session.Step ? "current" : "")"
                data-protocol-step="@(index + 1)"
                aria-current="@(index == _session.Step ? "step" : null)">@EventDemoSession.Steps[index]</li>
        }
    </ol>
    <ProtocolSequence Participants="EventParticipants" Messages="ActiveSequence" CompletedSteps="_session.Step" />
    @if (_session.Payload is not null)
    {
        <section class="events-receipt" aria-label="Verified event">
            <h2>Verified notification</h2>
            <dl><dt>Context</dt><dd>@_session.Context</dd><dt>Event ID</dt><dd>@_session.Eid</dd><dt>Duplicate</dt><dd>Ignored by issuer and event token jti</dd></dl>
            <pre data-testid="event-payload">@_session.Payload</pre>
        </section>
    }
    <section class="events-evidence" aria-label="Recorded exchanges">
        @foreach (var evidence in _session.Evidence)
        {
            <details open="@(evidence.Step == _session.Step)">
                <summary>@evidence.Step. @evidence.Exchange <strong>HTTP @evidence.StatusCode</strong></summary>
                <pre>@evidence.Json</pre>
            </details>
        }
    </section>
    @for (var index = 0; index < EventDemoCode.Steps.Length; index++)
    {
        <details class="events-code" data-code-step="@(index + 1)" open="@(index == Math.Min(_session.Step, 5))">
            <summary>@(index + 1). @EventDemoSession.Steps[index] (C#)</summary>
            <pre><code class="language-csharp">@EventDemoCode.Steps[index]</code></pre>
        </details>
    }
    <footer class="events-limits">
        <p>Single-shot sample: <code>max_uses: 1</code>. AP token acquisition, authenticated polling, acknowledgement and the notification trigger are local sample APIs, not standard endpoints.</p>
        <p>Unlimited AP subscriptions are supported. Each event token carries its own <code>jti</code>, and the AP and agent deduplicate on issuer and <code>jti</code>, so recurring notifications under one subscription are all delivered and only a resent copy is ignored.</p>
    </footer>
</section>

@code {
    private static readonly ProtocolParticipant[] EventParticipants =
    [
        new("agent", "Agent"),
        new("resource", "Bookings"),
        new("ap", "Agent Provider"),
        new("ps", "Person Server"),
        new("browser", "User / Browser"),
    ];

    private static readonly ProtocolMessage[] Sequence =
    [
        ProtocolMessage.Http(1, "network", "agent", "resource", "GET metadata and AsyncAPI channels", responseLabel: "200"),
        ProtocolMessage.Http(1, "network", "agent", "ap", "GET event endpoint metadata", responseLabel: "200"),
        ProtocolMessage.Http(2, "setup", "agent", "ap", "Signed enrollment; receive agent JWT", responseLabel: "200"),
        ProtocolMessage.Local(2, "agent", "Select public channel URL", false),
        ProtocolMessage.Http(2, "network", "agent", "resource", "Signed search; receive authorization challenge", "401", true),
        ProtocolMessage.Http(2, "network", "agent", "ps", "Exchange resource token and poll pending grant", "202/200", true),
        ProtocolMessage.Http(2, "network", "browser", "ps", "Authenticated account consent", "200", true),
        ProtocolMessage.Http(2, "network", "agent", "resource", "Receive protected subscription ticket", "200", true),
        ProtocolMessage.Http(3, "network", "agent", "ap", "Acquire subscribe token", responseLabel: "200"),
        ProtocolMessage.Local(3, "agent", "Persist event ID, issuer, and account context"),
        ProtocolMessage.Http(4, "network", "agent", "resource", "Register with aa-subscribe+jwt", responseLabel: "200"),
        ProtocolMessage.Http(5, "network", "agent", "resource", "Trigger sample notification", responseLabel: "202"),
        ProtocolMessage.Http(5, "network", "resource", "ap", "Deliver self-jwt event", responseLabel: "202"),
        ProtocolMessage.Http(6, "network", "agent", "ap", "Poll the signed event inbox", responseLabel: "200"),
        ProtocolMessage.Local(6, "agent", "Verify and deduplicate event"),
        ProtocolMessage.Http(6, "network", "agent", "ap", "Acknowledge event", responseLabel: "200"),
    ];
    private IReadOnlyList<ProtocolMessage> ActiveSequence =>
        Sequence.Where(message => message.Protected is null || message.Protected == _session.Protected).ToArray();
    private EventDemoSession _session = null!;
    private readonly CancellationTokenSource _cancellation = new();
    private bool _busy;
    private bool _interactive;
    private string? _error;

    protected override void OnInitialized() => CreateSession();

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        _interactive = true;
        StateHasChanged();
    }

    private void CreateSession()
    {
        var directory = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), ".aauth", "event-ui", Guid.NewGuid().ToString("N"));
        _session = new EventDemoSession(directory,
            Configuration["AAuth:AgentProvider"] ?? "http://localhost:5301",
            Configuration["AAuth:Bookings"] ?? "http://localhost:5005",
            Configuration["AAuth:PersonServer"] ?? "http://localhost:5100");
        _session.Changed = () => InvokeAsync(StateHasChanged);
    }

    private async Task Next()
    {
        _busy = true; _error = null;
        try { await _session.NextAsync(_cancellation.Token); }
        catch (Exception exception) when (exception is not OperationCanceledException) { _error = exception.Message; }
        finally { _busy = false; }
    }

    private void Reset()
    {
        _session.Dispose();
        CreateSession();
        _error = null;
    }

    public void Dispose()
    {
        _cancellation.Cancel();
        _cancellation.Dispose();
        _session.Dispose();
    }
}