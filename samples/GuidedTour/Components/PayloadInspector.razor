@* Right-pane inspector: narrative + collapsible panels for each captured artifact. *@
@inject Microsoft.Extensions.Options.IOptions<TourOptions> Options

<article class="inspector">
    <h2>@Step.Number. @Step.Title</h2>
    <p class="from-to"><strong>@ActorLabel(Step.From)</strong> → <strong>@ActorLabel(Step.To)</strong></p>
    <p class="narrative">@(RenderNarrative(Step.Narrative))</p>

    @if (!string.IsNullOrWhiteSpace(Step.CodeSnippet))
    {
        <details open>
            <summary>SDK code@(string.IsNullOrWhiteSpace(Step.CodeSnippetRole) ? null : $" · {Step.CodeSnippetRole}")</summary>
            <pre class="code-snippet"><code>@(HighlightCSharp(Step.CodeSnippet))</code></pre>
        </details>
    }

    @if (!string.IsNullOrWhiteSpace(Step.RequestLine))
    {
        <details open>
            <summary>Request</summary>
            <pre><code>@(HighlightBlock(Step.RequestLine + "\n\n" + Step.RequestHeaders + (string.IsNullOrEmpty(Step.RequestBody) ? "" : "\n\n" + Step.RequestBody)))</code></pre>
        </details>
    }

    @if (!string.IsNullOrWhiteSpace(Step.SignatureBase))
    {
        <details>
            <summary>RFC 9421 signature base</summary>
            <pre><code>@(HighlightBlock(Step.SignatureBase))</code></pre>
        </details>
    }

    @if (!string.IsNullOrWhiteSpace(Step.StatusLine))
    {
        <details open>
            <summary>Response</summary>
            <pre><code>@(HighlightBlock(Step.StatusLine + "\n\n" + Step.ResponseHeaders + "\n\n" + Step.ResponseBody))</code></pre>
        </details>
    }

    @if (!string.IsNullOrWhiteSpace(Step.TokenJwt)
        || !string.IsNullOrWhiteSpace(Step.TokenHeader)
        || !string.IsNullOrWhiteSpace(Step.TokenPayload)
        || !string.IsNullOrWhiteSpace(Step.TokenDecoded))
    {
        <TokenView Jwt="@Step.TokenJwt"
                   Header="@Step.TokenHeader"
                   Payload="@Step.TokenPayload"
                   Decoded="@Step.TokenDecoded" />
    }
</article>

@code {
    [Parameter, EditorRequired] public StepRecord Step { get; set; } = default!;

    private static string ActorLabel(Actor a) => a switch
    {
        Actor.PersonServer => "Person Server",
        Actor.AgentProvider => "Agent Provider",
        Actor.AccessServer => "Access Server",
        Actor.SubAgent => "Sub-Agent",
        _ => a.ToString(),
    };

    private EntityHighlighter? _highlighter;

    private EntityHighlighter Highlighter =>
        _highlighter ??= new EntityHighlighter(Options.Value);

    /// <summary>HTML-escapes then applies entity highlighting.</summary>
    private MarkupString HighlightBlock(string? text)
    {
        if (string.IsNullOrEmpty(text)) return new MarkupString(string.Empty);
        var escaped = System.Net.WebUtility.HtmlEncode(text);
        return new MarkupString(Highlighter.Highlight(escaped));
    }

    /// <summary>Basic C# syntax highlighting via single-pass regex.</summary>
    private static MarkupString HighlightCSharp(string code)
    {
        var escaped = System.Net.WebUtility.HtmlEncode(code);

        // Single-pass: comments | strings | keywords | types.
        // First match wins — content inside a string/comment won't be
        // re-highlighted as a keyword.
        var pattern =
            @"(\/\/.*)$" +                                          // group 1: comment
            @"|(\$?&quot;[^&]*?&quot;)" +                           // group 2: string
            @"|(\b(?:var|new|await|using|async|null|true|false|return|string|int|void)\b)" + // group 3: keyword
            @"|(\b(?:AAuthKey|AgentTokenBuilder|AAuthClientBuilder|AgentProviderClient|TokenExchangeClient|DeferredPoller|DeferredPollerOptions|AAuthTokenHolder|AAuthRequirementHeader|JsonNode|TimeSpan|Process|ProcessStartInfo|Uri)\b)"; // group 4: type

        escaped = System.Text.RegularExpressions.Regex.Replace(
            escaped,
            pattern,
            m =>
            {
                if (m.Groups[1].Success) return $"<span class=\"cs-comment\">{m.Value}</span>";
                if (m.Groups[2].Success) return $"<span class=\"cs-string\">{m.Value}</span>";
                if (m.Groups[3].Success) return $"<span class=\"cs-keyword\">{m.Value}</span>";
                if (m.Groups[4].Success) return $"<span class=\"cs-type\">{m.Value}</span>";
                return m.Value;
            },
            System.Text.RegularExpressions.RegexOptions.Multiline);

        return new MarkupString(escaped);
    }

    // Renders narrative text with backtick-quoted spans (`like-this`) as
    // <code> elements and **bold** as <strong>. Newlines become <br/>.
    // Input is HTML-escaped first so user-supplied text can't inject markup.
    private static MarkupString RenderNarrative(string text)
    {
        var escaped = System.Net.WebUtility.HtmlEncode(text ?? string.Empty);
        // **bold**
        escaped = System.Text.RegularExpressions.Regex.Replace(
            escaped,
            @"\*\*([^*]+)\*\*",
            "<strong>$1</strong>");
        // `code`
        escaped = System.Text.RegularExpressions.Regex.Replace(
            escaped,
            "`([^`]+)`",
            "<code class=\"inline\">$1</code>");
        // newlines → <br/>
        escaped = escaped.Replace("\n", "<br/>");
        return new MarkupString(escaped);
    }
}
