@page "/tour"
@rendermode InteractiveServer
@implements IDisposable
@inject TourSession Session
@inject Microsoft.Extensions.Options.IOptions<TourOptions> Options

<PageTitle>AAuth Guided Tour</PageTitle>

<header class="topbar">
    <a class="topbar__back" href="">← Overview</a>
    <h1>AAuth Guided Tour</h1>
    <div class="config">
        <span class="hl-resource"><strong>@Session.ResourceDisplayName:</strong> @Session.ResourceBaseUrl</span>
        @if (Session.IsCallChainMode)
        {
            <span class="hl-resource"><strong>Concierge:</strong> @Options.Value.ConciergeUrl</span>
        }
        @if (Session.IsFederatedMode)
        {
            <span class="hl-as"><strong>Access Server:</strong> @Options.Value.AccessServerUrl</span>
        }
        @if (Session.IsRichRequestsMode)
        {
            <span class="hl-as"><strong>R3 Access Server:</strong> @Options.Value.R3AccessServerUrl</span>
        }
        @if (!Session.IsIdentityMode && !Session.IsResourceManagedMode)
        {
            <span class="hl-ps"><strong>Person Server:</strong> @(string.IsNullOrWhiteSpace(Options.Value.PersonServerUrl) ? "(none)" : Options.Value.PersonServerUrl)</span>
        }
        <span class="hl-agent"><strong>Agent Provider:</strong> @(string.IsNullOrWhiteSpace(Options.Value.AgentProviderUrl) ? "(none)" : new Uri(Options.Value.AgentProviderUrl).GetLeftPart(UriPartial.Authority))</span>
    </div>
    @if (_error is not null)
    {
        <div class="error">@_error</div>
    }
</header>

<section class="flow-picker">
    <label class="flow-picker__label" for="flow-select">
        <span class="flow-picker__title">Pick a flow to demo</span>
        <select id="flow-select" value="@Session.Mode" @onchange="OnModeChangedAsync" disabled="@_busy">
            <option value="@TourMode.Bootstrap" disabled="@(!Session.HasAgentProvider)">1 · Bootstrap — keygen + AP enrol</option>
            <option value="@TourMode.Identity">2 · Identity-based — no PS, 2 steps</option>
            <option value="@TourMode.ResourceManaged">3 · Resource-Managed (Two-Party) — own consent, 6 steps</option>
            <option value="@TourMode.Autonomous" disabled="@(!Session.HasPersonServer)">4 · PS-Asserted (Direct Grant) — no user, 6 steps</option>
            <option value="@TourMode.Deferred" disabled="@(!Session.HasPersonServer)">5 · PS-Asserted (Deferred) — user approves, 9 steps</option>
            <option value="@TourMode.CallChain" disabled="@(!Session.HasPersonServer || !Session.HasConcierge)">6 · Call Chain (Multi-Agent) — user approves, 7 or 13 steps</option>
            <option value="@TourMode.Federated" disabled="@(!Session.HasPersonServer || !Session.HasAccessServer)">7 · Federated (Four-Party) — Access Server, 7–10 steps</option>
            <option value="@TourMode.RichRequests" disabled="@(!Session.HasPersonServer || !Session.HasR3AccessServer)">8 · Rich Resource Requests (R3) — R3 Access Server, 14 steps</option>
            <option value="@TourMode.Mission" disabled="@(!Session.HasPersonServer)">9 · Mission (PS-Governed) — three prompts, 20 steps</option>
            <option value="@TourMode.MissionCallChain" disabled="@(!Session.HasPersonServer || !Session.HasConcierge)">10 · Mission + Call Chain — dual governance, 14 steps</option>
            <option value="@TourMode.SubAgent">11 · Sub-Agents — parent-mediated worker, 7 steps</option>
        </select>
    </label>
    @if (Session.Mode == TourMode.Identity)
    {
        <label class="flow-picker__label" for="signing-mode-select">
            <span class="flow-picker__title">Signing mode</span>
            <select id="signing-mode-select" value="@Session.SigningMode" @onchange="OnSigningModeChanged" disabled="@_busy">
                <option value="@SigningMode.Hwk">Pseudonymous (hwk) — key only, no identity</option>
                <option value="@SigningMode.JwksUri">Agent Identity (jwks_uri) — JWKS-discoverable</option>
                <option value="@SigningMode.JktJwt">Key Rotation (jkt-jwt) — ephemeral keys</option>
            </select>
        </label>
    }
    <div class="flow-picker__actions">
        @if (Session.AwaitingUserApproval)
        {
            <a class="primary approve" href="@Session.UserInteractionUrl" target="_blank" rel="noopener"
               @onclick="MarkInteractionOpenedAsync" @onclick:preventDefault="false">
                @(Session.IsFederatedMode ? "Open Access Server consent ↗" : Session.IsRichRequestsMode ? "Open R3 Access Server consent ↗" : "Open consent page ↗")
            </a>
        }
        else
        {
            <button class="primary" @onclick="NextAsync" disabled="@(Session.IsComplete || _busy)">
                @(_busy ? "Running…" : Session.IsAborted ? "Aborted" : Session.IsComplete ? "Done" : StepButtonLabel())
            </button>
        }
        <button @onclick="RunAllAsync" disabled="@(Session.IsComplete || _busy)">Run all</button>
        <button @onclick="ResetAsync" disabled="@_busy">Reset</button>
    </div>
    <details class="flow-picker__desc" open>
        <summary>📖 What Aria is trying to do — and how</summary>
        @switch (Session.Mode)
        {
            case TourMode.Bootstrap:
                <text>
                    Before Aria (your AI travel assistant) can help you with
                    anything, it needs an identity of its own — here it generates a keypair and
                    registers with an Agent Provider so every later flow can prove who it is.<br /><br />
                    The agent generates a keypair and registers with an Agent Provider to obtain
                    a signed <code>aa-agent+jwt</code>. Required before Agent Identity
                    (<code>jwks_uri</code>) access and all Person Server flows (Direct Grant / Deferred).
                    Not needed for Pseudonymous (<code>hwk</code>) access — that uses a bare key.
                    <strong>Agent ↔ Agent Provider only.</strong><br /><br />
                    <em>Who enrols?</em> Only agents <strong>without</strong> a stable URL —
                    CLI tools, desktop, mobile, or browser apps like this one — enrol with a
                    separate Agent Provider. A <strong>hosted service</strong> with its own
                    domain is <strong>its own provider</strong>: it self-issues agent tokens
                    signed by its published JWKS key, so it skips this step entirely.
                </text>
                break;
            case TourMode.Identity:
                <text>
                    Aria (your AI travel assistant) wants to read something from
                    your <strong>Profile</strong> server, and the server decides access purely from the
                    signature on the request — no Person Server and no consent screen.<br /><br />
                    The resource verifies the agent's signature and applies its own access
                    control — granting or denying based on who (or what key) signed the request.
                    The signed request hits the mode's dedicated endpoint
                    (<code>/pseudonymous</code>, <code>/anchored</code>, or <code>/identified</code>) and returns
                    <code>200</code> on the first call — no Person Server involved.
                    @switch (Session.SigningMode)
                    {
                        case SigningMode.Hwk:
                            <strong>Pseudonymous:</strong>
                            <text> resource sees a key thumbprint only — no agent identity disclosed.</text>
                            break;
                        case SigningMode.JwksUri:
                            <strong>Agent Identity:</strong>
                            <text> resource discovers agent's public key via JWKS URI — replaces API keys.</text>
                            break;
                        case SigningMode.JktJwt:
                            <strong>Key Rotation:</strong>
                            <text> durable key signs a naming JWT binding an ephemeral signing key — enables rotation without re-enrolment.</text>
                            break;
                    }
                </text>
                break;
            case TourMode.ResourceManaged:
                <text>
                    Aria (your AI travel assistant) wants to read your
                    <strong>Inbox</strong> to import trip confirmations, but there's no Person
                    Server in sight — the Inbox manages authorization <strong>itself</strong>,
                    exactly like the OAuth provider it's replacing.<br /><br />
                    <strong>Signing mode: Pseudonymous (<code>hwk</code>)</strong> — two parties only,
                    no token exchange. The agent's first signed <code>GET /messages</code> returns
                    <code>202</code> with the Inbox's <strong>own</strong> consent URL; the user clicks
                    <strong>Approve</strong> on the Inbox's page in a new tab; the agent polls a pending
                    URL until the Inbox issues an <strong>opaque <code>AAuth-Access</code> token</strong>.
                    On the retry the agent sends <code>Authorization: AAuth &lt;token&gt;</code> and the
                    signature <strong>covers <code>authorization</code></strong>, binding the token to the
                    request so a stolen copy is worthless. <strong>One human approval — the access mode
                    that drops in where you already use OAuth.</strong>
                </text>
                break;
            case TourMode.Autonomous:
                <text>
                    Aria (your AI travel assistant) is planning a trip and reads
                    your <strong>Calendar</strong> to see when you're free. Because you granted standing
                    consent earlier, it never has to interrupt you.<br /><br />
                    <strong>Signing mode: Agent Token (<code>sig=jwt</code>)</strong> — required for all
                    Person Server flows.
                    The agent already has standing consent at the Person Server. <code>POST /token</code>
                    returns <code>200</code> immediately with an <code>auth_token</code>; the agent retries the
                    resource and gets <code>200</code>. <strong>No human in the loop.</strong>
                </text>
                break;
            case TourMode.Deferred:
                <text>
                    Aria (your AI travel assistant) wants to read your
                    <strong>Calendar</strong> to plan around your schedule, but you haven't approved it
                    yet — so it pauses and waits for your one-time approval.<br /><br />
                    <strong>Signing mode: Agent Token (<code>sig=jwt</code>)</strong> — required for all
                    Person Server flows.
                    The agent has <em>no</em> consent yet. <code>POST /token</code> returns <code>202 Accepted</code>
                    with an interaction URL; the user clicks <strong>Approve</strong> at the PS's consent page in
                    a new tab; the agent polls a pending URL until the PS mints the <code>auth_token</code>.
                    <strong>Human approval required.</strong>
                </text>
                break;
            case TourMode.CallChain:
                <text>
                    Aria (your AI travel assistant) doesn't read your
                    <strong>Calendar</strong> itself — it hands the job to a <strong>Concierge</strong>
                    service that reads it on Aria's behalf, so you consent once for each hop.<br /><br />
                    <strong>Signing mode: Agent Token (<code>sig=jwt</code>)</strong> — multi-agent delegation.
                    The agent calls a <strong>Concierge</strong> (an intermediate service) which itself calls
                    a downstream resource (Calendar). The Concierge passes the agent's auth_token as
                    <code>upstream_token</code> during its own PS exchange, producing a <strong>nested <code>act</code>
                    claim</strong> that records the full delegation chain. The final resource sees exactly who
                    acted on whose behalf. <strong>Human approval required — two consents:</strong> first
                    for <em>Agent → Concierge</em>, then for the Concierge's chained
                    <em>Concierge → Calendar</em> hop. Each surfaces its own interaction URL and pending poll.
                </text>
                break;
            case TourMode.Federated:
                <text>
                    Aria (your AI travel assistant) is ready to pay for a booking
                    and needs to charge your <strong>Wallet</strong>, but your money is held by a separate
                    financial provider that makes the final call on the payment.<br /><br />
                    <strong>Signing mode: Agent Token (<code>sig=jwt</code>)</strong> — four-party
                    federation.
                    The resource's <code>/wallet</code> branch challenges with a resource_token
                    whose <code>aud</code> is an <strong>Access Server</strong> (not the Person Server).
                    The agent forwards it to its PS unchanged; the PS notices <code>aud ≠ self</code>,
                    federates to the AS, and the <strong>Access Server</strong> evaluates policy and
                    mints the <code>aa-auth+jwt</code> (<code>dwk=aauth-access.json</code>). The resource
                    verifies it against the AS's JWKS. <strong>Interactive consent at the Access
                    Server</strong> — you'll either approve at the stub AS's own Approve/Deny
                    screen (<code>make demo</code>) or sign in at a Keycloak login
                    (<code>make demo-keycloak</code>).
                </text>
                break;
            case TourMode.RichRequests:
                <text>
                    Aria (your AI travel assistant) is booking your evening — it searches for a
                    table and then confirms a reservation through <strong>Bookings</strong>, whose
                    dedicated <strong>R3 Access Server</strong> decides each operation on its own
                    policy rather than an opaque scope.<br /><br />
                    <strong>Signing mode: Agent Token (<code>sig=jwt</code>)</strong> — four-party
                    <strong>Rich Resource Requests (R3)</strong>. Bookings publishes a
                    content-addressed <strong>R3 document</strong> (in the <strong>OpenAPI</strong>
                    vocabulary) describing its operations; the auth token then carries
                    <code>r3_granted</code> and <code>r3_conditional</code> instead of scopes.
                    <strong>searchAvailability</strong> is <code>r3_granted</code> — served
                    outright, no prompt. <strong>confirmReservation</strong> charges a deposit, so
                    the AS makes it <code>r3_conditional</code>: on that call Bookings returns a
                    <strong>per-call proposal</strong> carrying the concrete reservation (venue,
                    date, party size, deposit), and the R3 Access Server asks <strong>you</strong>
                    to approve that specific booking at its own consent screen before it mints a
                    per-call token. Bookings then re-hashes your presented parameters against the
                    approved proposal's digest before it commits. <strong>Low-risk reads flow
                    freely; consequential actions get your per-call consent.</strong>
                </text>
                break;
            case TourMode.Mission:
                <text>
                    You give Aria (your AI travel assistant) a standing mission to
                    plan and book a trip. From then on it works against your <strong>Trips</strong> server
                    freely, only stopping to ask you when an action falls outside what you approved.<br /><br />
                    <strong>Signing mode: Agent Token (<code>sig=jwt</code>)</strong> — the Person Server
                    acts as the <strong>policy-enforcement point</strong>. The agent first proposes a durable
                    <strong>mission</strong> (description + pre-approved tools) which the user approves once;
                    every later request is then checked against it. An <em>in-scope</em> token (<code>trips.read</code>)
                    is minted <strong>silently</strong>; an <em>out-of-mission</em> scope (<code>trips.book</code>)
                    <strong>prompts</strong>; a <em>pre-approved</em> tool (<code>add_to_calendar</code>) is
                    resolved <strong>locally</strong> with no PS call; and an <em>out-of-scope</em> action
                    (<code>cancel_booking</code>) <strong>prompts</strong> again. <strong>Three human approvals:</strong>
                    creating the mission, the out-of-mission scope, and the out-of-scope action — everything in between flows without friction.
                </text>
                break;
            case TourMode.MissionCallChain:
                <text>
                    Under one trip-planning mission,
                    Aria (your AI travel assistant) first clarifies what you want, then delegates the work down a chain of services to
                    reach your <strong>Trips</strong> server — all governed by that single approval.<br /><br />
                    <strong>Signing mode: Agent Token (<code>sig=jwt</code>)</strong> — one durable
                    <strong>mission</strong> governs two very different kinds of access. An
                    <em>out-of-mission</em> elevated scope (<code>trips.book</code>) first triggers a
                    <strong>clarification chat</strong> — the PS asks <em>why</em>, the agent answers — and only
                    then prompts the user to approve. After that, a <strong>mission-forwarded call chain</strong>
                    (Agent → Concierge → Trips) flows <strong>silently</strong>: because both hops
                    (<code>concierge</code>, <code>trips.read</code>) are in the mission's scope, the Concierge
                    forwards the <code>AAuth-Mission</code> header downstream and no prompt is needed.
                    <strong>Two human approvals</strong> (mission creation, the clarified elevated scope) frame an
                    otherwise-silent multi-agent chain, and the PS's <strong>mission log</strong> records it all.
                </text>
                break;
            case TourMode.SubAgent:
                <text>
                    Aria (your AI travel assistant) spins up a short-lived
                    <strong>worker</strong> — a <strong>separate process / sandbox</strong> — to handle one
                    slice of a task (searching flights) under the single consent <em>you</em> already gave
                    Aria. The worker generates its <strong>own</strong> key and gets its own identity from the
                    <strong>Agent Provider</strong> (so it's individually auditable and revocable, and not even
                    Aria can impersonate it), but it never talks to your Person Server directly:
                    <strong>Aria mediates</strong> on its behalf.<br /><br />
                    The worker's agent token carries a <code>parent_agent</code> claim naming Aria. The
                    worker obtains a <code>resource_token</code> bound to <em>its own</em> key and hands it up
                    to the parent; Aria then signs <code>POST /token</code> with the <strong>parent's</strong>
                    key, including the worker's token as <code>subagent_token</code>. The Person Server binds
                    the issued <code>auth_token</code> to the <strong>worker</strong> (nesting the
                    <code>act</code> claim <code>{ sub: worker, act: { sub: parent } }</code> for audit) and
                    returns it to the <strong>parent</strong> — which <strong>hands it down</strong> to the
                    worker, the only party whose key can use it.
                    Delegation stays <strong>one level deep</strong> — a sub-agent can't spawn its own
                    sub-agents.<br /><br />
                    <em>Runs entirely in-process with the real SDK builders</em> — no live servers — so every
                    wire artifact is built and shown directly. <strong>No human approval in this demo.</strong>
                </text>
                break;
        }
    </details>
</section>

@if (Session.IsPolling)
{
    <section class="polling">
        <span class="polling__spinner" aria-hidden="true"></span>
        <div class="polling__body">
            <div class="polling__title">Step @Session.PollStepNumber — polling pending URL…</div>
            <div class="polling__detail">
                Signed <code>GET @Session.PendingUrlPath</code> ·
                <strong>@Session.PollCount</strong> @(Session.PollCount == 1 ? "poll" : "polls") so far ·
                elapsed <strong>@ElapsedPolling()</strong>
            </div>
            <div class="polling__hint">
                Waiting for you to complete the @(Session.IsFederatedMode ? "Access Server consent" : Session.IsRichRequestsMode ? "R3 Access Server consent" : Session.IsResourceManagedMode ? "Approve on the Inbox consent" : "Approve or Deny on the PS consent")
                tab. You can come back here anytime — the poll loop is live.
            </div>
        </div>
    </section>
}

<div class="layout">
    <aside class="steps">
        <StepList Steps="@Session.Steps" Plan="@Session.Plan" Selected="@_selected" OnSelect="@(i => _selected = i)" />
    </aside>

    <section class="diagram">
        <SequenceDiagram Steps="@Session.Steps"
                         Highlight="@_selected"
                         Lanes="@ActiveLanes"
                         IsPolling="@Session.IsPolling"
                         PollCount="@Session.PollCount"
                         LoopGhostStep="@((Session.IsDeferredMode || Session.IsFederatedMode || Session.IsCallChainPending || Session.IsMissionMode || Session.IsMissionCallChainMode || Session.IsResourceManagedMode) ? new SequenceDiagram.GhostStep(Session.PollStepNumber, $"polling /pending/{{id}}…", Actor.Agent, Session.PollLoopTarget) : null)"
                         LoopAroundStepNumber="@((Session.IsDeferredMode || Session.IsFederatedMode || Session.IsCallChainPending || Session.IsMissionMode || Session.IsMissionCallChainMode || Session.IsResourceManagedMode) ? Session.PollStepNumber : 0)"
                         CompletedLoopLabel="@CompletedLoopLabel()"
                         LoopCompletedKind="@CompletedLoopKind()" />
    </section>

    <section class="payload">
        @if (Selected is not null)
        {
            <PayloadInspector Step="@Selected" />
        }
        else
        {
            <p class="hint">Run a step to see its payloads here.</p>
        }
    </section>
</div>

@code {
    private int _selected = -1;
    private bool _busy;
    private string? _error;
    private bool _initialized;

    /// <summary>
    /// Optional <c>?flow=</c> query parameter (e.g. <c>/tour?flow=Mission</c>) used by the
    /// Overview page's flow cards to deep-link straight into a specific flow.
    /// </summary>
    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery]
    public string? Flow { get; set; }

    private static readonly SequenceDiagram.LaneDefinition[] BootstrapLanes =
    {
        new("Agent", "agent", Actor.Agent),
        new("Agent Provider", "ap", Actor.AgentProvider),
    };

    private static readonly SequenceDiagram.LaneDefinition[] IdentityLanes =
    {
        new("Agent", "agent", Actor.Agent),
        new("Profile", "resource", Actor.Resource),
    };

    // Resource-managed (two-party AAuth-Access) flow: agent ↔ Inbox only. No
    // Person Server lane — the Inbox manages authorization itself.
    private static readonly SequenceDiagram.LaneDefinition[] ResourceManagedLanes =
    {
        new("Agent", "agent", Actor.Agent),
        new("Inbox", "resource", Actor.Resource),
    };

    // Autonomous + Deferred three-party flows target the Calendar.
    private static readonly SequenceDiagram.LaneDefinition[] ThreePartyLanes =
    {
        new("Agent", "agent", Actor.Agent),
        new("Calendar", "resource", Actor.Resource),
        new("Person Server", "ps", Actor.PersonServer),
    };

    private static readonly SequenceDiagram.LaneDefinition[] CallChainLanes =
    {
        new("Agent", "agent", Actor.Agent),
        new("Concierge", "resource", Actor.Concierge),
        new("Calendar", "resource2", Actor.Resource),
        new("Person Server", "ps", Actor.PersonServer),
    };

    private static readonly SequenceDiagram.LaneDefinition[] FederatedLanes =
    {
        new("Agent", "agent", Actor.Agent),
        new("Wallet", "resource", Actor.Resource),
        new("Person Server", "ps", Actor.PersonServer),
        new("Access Server", "as", Actor.AccessServer),
    };

    // Rich Resource Requests (R3) four-party flow: agent ↔ Bookings, with the
    // Person Server federating to a dedicated R3 Access Server (same red `as`
    // lane the Federated flow uses).
    private static readonly SequenceDiagram.LaneDefinition[] RichRequestsLanes =
    {
        new("Agent", "agent", Actor.Agent),
        new("Bookings", "resource", Actor.Resource),
        new("Person Server", "ps", Actor.PersonServer),
        new("R3 Access Server", "as", Actor.AccessServer),
    };

    private static readonly SequenceDiagram.LaneDefinition[] MissionLanes =
    {
        new("Agent", "agent", Actor.Agent),
        new("Trips", "resource", Actor.Resource),
        new("Person Server", "ps", Actor.PersonServer),
    };

    private static readonly SequenceDiagram.LaneDefinition[] MissionCallChainLanes =
    {
        new("Agent", "agent", Actor.Agent),
        new("Trips", "resource", Actor.Resource),
        new("Concierge", "resource2", Actor.Concierge),
        new("Person Server", "ps", Actor.PersonServer),
    };

    // Sub-agent flow: a parent-mediated worker. The parent and worker each
    // get their own lane; the worker fetches the resource token, the parent
    // exchanges at the Person Server.
    private static readonly SequenceDiagram.LaneDefinition[] SubAgentLanes =
    {
        new("Parent", "agent", Actor.Parent),
        new("Sub-Agent", "ap", Actor.SubAgent),
        new("Resource", "resource", Actor.Resource),
        new("Person Server", "ps", Actor.PersonServer),
    };

    private SequenceDiagram.LaneDefinition[]? ActiveLanes =>
        Session.IsBootstrapMode ? BootstrapLanes :
        Session.IsSubAgentMode ? SubAgentLanes :
        Session.IsResourceManagedMode ? ResourceManagedLanes :
        Session.IsIdentityMode ? IdentityLanes :
        Session.IsMissionCallChainMode ? MissionCallChainLanes :
        Session.IsCallChainMode ? CallChainLanes :
        Session.IsRichRequestsMode ? RichRequestsLanes :
        Session.IsFederatedMode ? FederatedLanes :
        Session.IsMissionMode ? MissionLanes : ThreePartyLanes;

    protected override async Task OnInitializedAsync()
    {
        if (_initialized) return;
        _initialized = true;
        // Deep-link support: the Overview page links to /tour?flow=<Mode>. When a
        // valid flow is supplied, preselect it before preparing consent state so
        // the PS's consent store matches the linked mode.
        if (!string.IsNullOrWhiteSpace(Flow) && Enum.TryParse<TourMode>(Flow, ignoreCase: true, out var linkedMode))
        {
            Session.Mode = linkedMode;
        }
        // Sync the MockPS consent store so each fresh tour session starts
        // in the right state for its configured mode.
        await Session.PrepareConsentStateAsync();
        // The polling task runs in the background and pings us via
        // StateChanged after each poll — marshal those onto the UI
        // synchronization context so Blazor re-renders the spinner.
        Session.StateChanged += OnSessionStateChanged;
    }

    public void Dispose()
    {
        Session.StateChanged -= OnSessionStateChanged;
    }

    private void OnSessionStateChanged()
    {
        // Polling thread → dispatcher. Swallow if the circuit is already
        // tearing down.
        try { _ = InvokeAsync(StateHasChanged); } catch { }
    }

    private string ElapsedPolling()
    {
        if (Session.PollingStartedAt is not { } start) { return "0s"; }
        var elapsed = DateTimeOffset.UtcNow - start;
        return elapsed.TotalSeconds < 60
            ? $"{elapsed.TotalSeconds:0}s"
            : $"{elapsed.Minutes}m {elapsed.Seconds:00}s";
    }

    private StepRecord? PollStepRecord =>
        (Session.IsDeferredMode || Session.IsFederatedMode || Session.IsCallChainPending || Session.IsResourceManagedMode)
            ? Session.Steps.FirstOrDefault(s => s.Number == Session.PollStepNumber)
            : null;

    private string? CompletedLoopLabel()
    {
        var pollStep = PollStepRecord;
        if (pollStep is null) { return null; }
        var pollCount = Session.PollCount > 0 ? $" · {Session.PollCount} polls" : "";
        if (pollStep.Title.Contains("denied", StringComparison.OrdinalIgnoreCase))
        {
            return $"loop [polled pending URL]{pollCount} · ✖ denied";
        }
        if (pollStep.Title.Contains("timeout", StringComparison.OrdinalIgnoreCase))
        {
            return $"loop [polled pending URL]{pollCount} · ⏱ timed out";
        }
        return $"loop [polled pending URL]{pollCount} · ✓ resolved";
    }

    private string? CompletedLoopKind()
    {
        var pollStep = PollStepRecord;
        if (pollStep is null) { return null; }
        if (pollStep.Title.Contains("denied", StringComparison.OrdinalIgnoreCase)) return "denied";
        if (pollStep.Title.Contains("timeout", StringComparison.OrdinalIgnoreCase)) return "timeout";
        return "ok";
    }

    private StepRecord? Selected =>
        _selected >= 0 && _selected < Session.Steps.Count ? Session.Steps[_selected] : null;

    private string StepButtonLabel() =>
        $"Run step {Session.Steps.Count + 1} / {Session.TotalSteps}";

    private async Task NextAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            await Session.RunNextAsync();
            _selected = Session.Steps.Count - 1;
        }
        catch (Exception ex)
        {
            _error = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally { _busy = false; }
    }

    private async Task MarkInteractionOpenedAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            // The <a target="_blank"> element opens the PS's interaction
            // page natively (no popup-blocker friction). This handler
            // records the user-approval step in the timeline and immediately kicks off
            // the background poll so the spinner is live while the
            // user is in the other tab.
            await Session.RecordUserApprovalOpenedAsync();
            _ = Session.StartPendingPollAsync();
            _selected = Session.Steps.Count - 1;
        }
        catch (Exception ex)
        {
            _error = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally { _busy = false; }
    }

    private async Task RunAllAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            while (!Session.IsComplete)
            {
                if (Session.AwaitingUserApproval)
                {
                    // "Run all" cannot do user interaction on the user's
                    // behalf — surface the URL and stop so the user can
                    // click the consent link themselves.
                    _error = Session.IsFederatedMode
                        ? "Stopped: the next step requires you to open the Access Server login (Keycloak) and sign in. Click the green link above."
                        : Session.IsRichRequestsMode
                        ? "Stopped: the next step requires you to open the R3 Access Server consent screen and approve this reservation. Click the green link above."
                        : "Stopped: the next step requires you to open the PS consent page and click Approve. Click the green link above.";
                    break;
                }
                await Session.RunNextAsync();
            }
            _selected = Session.Steps.Count - 1;
        }
        catch (Exception ex)
        {
            _error = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally { _busy = false; }
    }

    private async Task ResetAsync()
    {
        Session.Reset();
        _selected = -1;
        _error = null;
        await Session.PrepareConsentStateAsync();
    }

    private async Task OnModeChangedAsync(ChangeEventArgs e)
    {
        if (!Enum.TryParse<TourMode>(e.Value?.ToString(), out var mode))
        {
            return;
        }
        _busy = true;
        _error = null;
        try
        {
            // Mode setter resets the timeline; re-sync the PS's consent
            // store to match the new mode's expectations.
            Session.Mode = mode;
            await Session.PrepareConsentStateAsync();
            _selected = -1;
        }
        catch (Exception ex)
        {
            _error = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally { _busy = false; }
    }

    private void OnSigningModeChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<SigningMode>(e.Value?.ToString(), out var mode))
        {
            Session.SigningMode = mode; // setter resets the timeline
            _selected = -1;
        }
    }
}
