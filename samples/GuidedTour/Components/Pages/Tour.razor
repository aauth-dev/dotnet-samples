@page "/"
@rendermode InteractiveServer
@implements IDisposable
@inject TourSession Session
@inject Microsoft.Extensions.Options.IOptions<TourOptions> Options

<PageTitle>AAuth Guided Tour</PageTitle>

<header class="topbar">
    <h1>AAuth Guided Tour</h1>
    <div class="config">
        <span class="hl-resource"><strong>Resource:</strong> @Options.Value.WhoAmIUrl</span>
        @if (!Session.IsIdentityMode)
        {
            <span class="hl-ps"><strong>Person Server:</strong> @(string.IsNullOrWhiteSpace(Options.Value.PersonServerUrl) ? "(none)" : Options.Value.PersonServerUrl)</span>
        }
        <span class="hl-agent"><strong>Agent Provider:</strong> @(string.IsNullOrWhiteSpace(Options.Value.AgentProviderUrl) ? "(none)" : new Uri(Options.Value.AgentProviderUrl).GetLeftPart(UriPartial.Authority))</span>
    </div>
    @if (_error is not null)
    {
        <div class="error">@_error</div>
    }
</header>

<section class="flow-picker">
    <label class="flow-picker__label" for="flow-select">
        <span class="flow-picker__title">Pick a flow to demo</span>
        <select id="flow-select" value="@Session.Mode" @onchange="OnModeChangedAsync" disabled="@_busy">
            <option value="@TourMode.Bootstrap" disabled="@(!Session.HasAgentProvider)">1 · Bootstrap — keygen + AP enrol</option>
            <option value="@TourMode.Identity">2 · Identity-based — no PS, 2 steps</option>
            <option value="@TourMode.Autonomous" disabled="@(!Session.HasPersonServer)">3 · PS-Asserted (Direct Grant) — no user, 6 steps</option>
            <option value="@TourMode.Deferred" disabled="@(!Session.HasPersonServer)">4 · PS-Asserted (Deferred) — user approves, 9 steps</option>
        </select>
    </label>
    @if (Session.Mode == TourMode.Identity)
    {
        <label class="flow-picker__label" for="signing-mode-select">
            <span class="flow-picker__title">Signing mode</span>
            <select id="signing-mode-select" value="@Session.SigningMode" @onchange="OnSigningModeChanged" disabled="@_busy">
                <option value="@SigningMode.Hwk">Pseudonymous (hwk) — key only, no identity</option>
                <option value="@SigningMode.JwksUri">Agent Identity (jwks_uri) — JWKS-discoverable</option>
            </select>
        </label>
    }
    <div class="flow-picker__actions">
        @if (Session.AwaitingUserApproval)
        {
            <a class="primary approve" href="@Session.UserInteractionUrl" target="_blank" rel="noopener"
               @onclick="MarkInteractionOpenedAsync" @onclick:preventDefault="false">
                Open consent page ↗
            </a>
        }
        else
        {
            <button class="primary" @onclick="NextAsync" disabled="@(Session.IsComplete || _busy)">
                @(_busy ? "Running…" : Session.IsAborted ? "Aborted" : Session.IsComplete ? "Done" : StepButtonLabel())
            </button>
        }
        <button @onclick="RunAllAsync" disabled="@(Session.IsComplete || _busy)">Run all</button>
        <button @onclick="ResetAsync" disabled="@_busy">Reset</button>
    </div>
    <p class="flow-picker__desc">
        @switch (Session.Mode)
        {
            case TourMode.Bootstrap:
                <text>
                    The agent generates a keypair and registers with an Agent Provider to obtain
                    a signed <code>aa-agent+jwt</code>. Required before Agent Identity
                    (<code>jwks_uri</code>) access and all Person Server flows (Direct Grant / Deferred).
                    Not needed for Pseudonymous (<code>hwk</code>) access — that uses a bare key.
                    <strong>Agent ↔ Agent Provider only.</strong>
                </text>
                break;
            case TourMode.Identity:
                <text>
                    The resource verifies the agent's signature and applies its own access
                    control — granting or denying based on who (or what key) signed the request.
                    <code>GET /</code> returns <code>200</code> on the first call — no Person Server involved.
                    @switch (Session.SigningMode)
                    {
                        case SigningMode.Hwk:
                            <strong>Pseudonymous:</strong>
                            <text> resource sees a key thumbprint only — no agent identity disclosed.</text>
                            break;
                        case SigningMode.JwksUri:
                            <strong>Agent Identity:</strong>
                            <text> resource discovers agent's public key via JWKS URI — replaces API keys.</text>
                            break;
                    }
                </text>
                break;
            case TourMode.Autonomous:
                <text>
                    <strong>Signing mode: Agent Token (<code>sig=jwt</code>)</strong> — required for all
                    Person Server flows.
                    The agent already has standing consent at the Person Server. <code>POST /token</code>
                    returns <code>200</code> immediately with an <code>auth_token</code>; the agent retries the
                    resource and gets <code>200</code>. <strong>No human in the loop.</strong>
                </text>
                break;
            case TourMode.Deferred:
                <text>
                    <strong>Signing mode: Agent Token (<code>sig=jwt</code>)</strong> — required for all
                    Person Server flows.
                    The agent has <em>no</em> consent yet. <code>POST /token</code> returns <code>202 Accepted</code>
                    with an interaction URL; the user clicks <strong>Approve</strong> at the PS's consent page in
                    a new tab; the agent polls a pending URL until the PS mints the <code>auth_token</code>.
                    <strong>Human approval required.</strong>
                </text>
                break;
        }
    </p>
</section>

@if (Session.IsPolling)
{
    <section class="polling">
        <span class="polling__spinner" aria-hidden="true"></span>
        <div class="polling__body">
            <div class="polling__title">Step @Session.PollStepNumber — polling pending URL…</div>
            <div class="polling__detail">
                Signed <code>GET @Session.PendingUrlPath</code> ·
                <strong>@Session.PollCount</strong> @(Session.PollCount == 1 ? "poll" : "polls") so far ·
                elapsed <strong>@ElapsedPolling()</strong>
            </div>
            <div class="polling__hint">
                Waiting for you to click <strong>Approve</strong> or <strong>Deny</strong> on the
                PS consent tab. You can come back here anytime — the poll loop is live.
            </div>
        </div>
    </section>
}

<div class="layout">
    <aside class="steps">
        <StepList Steps="@Session.Steps" Plan="@Session.Plan" Selected="@_selected" OnSelect="@(i => _selected = i)" />
    </aside>

    <section class="diagram">
        <SequenceDiagram Steps="@Session.Steps"
                         Highlight="@_selected"
                         Lanes="@ActiveLanes"
                         IsPolling="@Session.IsPolling"
                         PollCount="@Session.PollCount"
                         LoopGhostStep="@(Session.IsDeferredMode ? new SequenceDiagram.GhostStep(Session.PollStepNumber, $"polling /pending/{{id}}…", Actor.Agent, Actor.PersonServer) : null)"
                         LoopAroundStepNumber="@(Session.IsDeferredMode ? Session.PollStepNumber : 0)"
                         CompletedLoopLabel="@CompletedLoopLabel()"
                         LoopCompletedKind="@CompletedLoopKind()" />
    </section>

    <section class="payload">
        @if (Selected is not null)
        {
            <PayloadInspector Step="@Selected" />
        }
        else
        {
            <p class="hint">Run a step to see its payloads here.</p>
        }
    </section>
</div>

@code {
    private int _selected = -1;
    private bool _busy;
    private string? _error;
    private bool _initialized;

    private static readonly SequenceDiagram.LaneDefinition[] BootstrapLanes =
    {
        new("Agent", "agent", Actor.Agent),
        new("Agent Provider", "ap", Actor.AgentProvider),
    };

    private static readonly SequenceDiagram.LaneDefinition[] IdentityLanes =
    {
        new("Agent", "agent", Actor.Agent),
        new("Resource", "resource", Actor.Resource),
    };

    private SequenceDiagram.LaneDefinition[]? ActiveLanes =>
        Session.IsBootstrapMode ? BootstrapLanes :
        Session.IsIdentityMode ? IdentityLanes : null;

    protected override async Task OnInitializedAsync()
    {
        if (_initialized) return;
        _initialized = true;
        // Sync the MockPS consent store so each fresh tour session starts
        // in the right state for its configured mode.
        await Session.PrepareConsentStateAsync();
        // The polling task runs in the background and pings us via
        // StateChanged after each poll — marshal those onto the UI
        // synchronization context so Blazor re-renders the spinner.
        Session.StateChanged += OnSessionStateChanged;
    }

    public void Dispose()
    {
        Session.StateChanged -= OnSessionStateChanged;
    }

    private void OnSessionStateChanged()
    {
        // Polling thread → dispatcher. Swallow if the circuit is already
        // tearing down.
        try { _ = InvokeAsync(StateHasChanged); } catch { }
    }

    private string ElapsedPolling()
    {
        if (Session.PollingStartedAt is not { } start) { return "0s"; }
        var elapsed = DateTimeOffset.UtcNow - start;
        return elapsed.TotalSeconds < 60
            ? $"{elapsed.TotalSeconds:0}s"
            : $"{elapsed.Minutes}m {elapsed.Seconds:00}s";
    }

    private StepRecord? PollStepRecord =>
        Session.IsDeferredMode
            ? Session.Steps.FirstOrDefault(s => s.Number == Session.PollStepNumber)
            : null;

    private string? CompletedLoopLabel()
    {
        var pollStep = PollStepRecord;
        if (pollStep is null) { return null; }
        var pollCount = Session.PollCount > 0 ? $" · {Session.PollCount} polls" : "";
        if (pollStep.Title.Contains("denied", StringComparison.OrdinalIgnoreCase))
        {
            return $"loop [polled pending URL]{pollCount} · ✖ denied";
        }
        if (pollStep.Title.Contains("timeout", StringComparison.OrdinalIgnoreCase))
        {
            return $"loop [polled pending URL]{pollCount} · ⏱ timed out";
        }
        return $"loop [polled pending URL]{pollCount} · ✓ resolved";
    }

    private string? CompletedLoopKind()
    {
        var pollStep = PollStepRecord;
        if (pollStep is null) { return null; }
        if (pollStep.Title.Contains("denied", StringComparison.OrdinalIgnoreCase)) return "denied";
        if (pollStep.Title.Contains("timeout", StringComparison.OrdinalIgnoreCase)) return "timeout";
        return "ok";
    }

    private StepRecord? Selected =>
        _selected >= 0 && _selected < Session.Steps.Count ? Session.Steps[_selected] : null;

    private string StepButtonLabel() =>
        $"Run step {Session.Steps.Count + 1} / {Session.TotalSteps}";

    private async Task NextAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            await Session.RunNextAsync();
            _selected = Session.Steps.Count - 1;
        }
        catch (Exception ex)
        {
            _error = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally { _busy = false; }
    }

    private async Task MarkInteractionOpenedAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            // The <a target="_blank"> element opens the PS's interaction
            // page natively (no popup-blocker friction). This handler
            // records the user-approval step in the timeline and immediately kicks off
            // the background poll so the spinner is live while the
            // user is in the other tab.
            await Session.RecordUserApprovalOpenedAsync();
            _ = Session.StartPendingPollAsync();
            _selected = Session.Steps.Count - 1;
        }
        catch (Exception ex)
        {
            _error = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally { _busy = false; }
    }

    private async Task RunAllAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            while (!Session.IsComplete)
            {
                if (Session.AwaitingUserApproval)
                {
                    // "Run all" cannot do user interaction on the user's
                    // behalf — surface the URL and stop so the user can
                    // click the consent link themselves.
                    _error = "Stopped: the next step requires you to open the PS consent page and click Approve. Click the green link above.";
                    break;
                }
                await Session.RunNextAsync();
            }
            _selected = Session.Steps.Count - 1;
        }
        catch (Exception ex)
        {
            _error = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally { _busy = false; }
    }

    private async Task ResetAsync()
    {
        Session.Reset();
        _selected = -1;
        _error = null;
        await Session.PrepareConsentStateAsync();
    }

    private async Task OnModeChangedAsync(ChangeEventArgs e)
    {
        if (!Enum.TryParse<TourMode>(e.Value?.ToString(), out var mode))
        {
            return;
        }
        _busy = true;
        _error = null;
        try
        {
            // Mode setter resets the timeline; re-sync the PS's consent
            // store to match the new mode's expectations.
            Session.Mode = mode;
            await Session.PrepareConsentStateAsync();
            _selected = -1;
        }
        catch (Exception ex)
        {
            _error = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally { _busy = false; }
    }

    private void OnSigningModeChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<SigningMode>(e.Value?.ToString(), out var mode))
        {
            Session.SigningMode = mode; // setter resets the timeline
            _selected = -1;
        }
    }
}
