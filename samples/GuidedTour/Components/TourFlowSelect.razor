@inject NavigationManager Navigation

<label class="flow-picker__label" for="flow-select">
    <span class="flow-picker__title">Pick a flow to demo</span>
    <select id="flow-select" value="@Value" @onchange="OnChanged" disabled="@Disabled">
        <option value="Bootstrap">1 · Bootstrap — keygen + AP enrol</option>
        <option value="Identity">2 · Generic Signature Keys - no PS, 2 steps</option>
        <option value="ResourceManaged">3 · Resource-Managed (Two-Party) — authenticated consent, 6 steps</option>
        <option value="Autonomous">4 · PS-Asserted (Direct Grant) — no user, 8 steps</option>
        <option value="Deferred">5 · PS-Asserted (Deferred) — authenticated consent, 11 steps</option>
        <option value="CallChain">6 · Call Chain (Multi-Agent) — user approves, 9 or 15 steps</option>
        <option value="Federated">7 · Federated (Four-Party) — Access Server, 9–12 steps</option>
        <option value="RichRequests">8 · Rich Resource Requests (R3) — R3 Access Server, 16 steps</option>
        <option value="Mission">9 · Mission (PS-Governed) — three prompts, 21 steps</option>
        <option value="MissionCallChain">10 · Mission + Call Chain — dual governance, 15 steps</option>
        <option value="SubAgent">11 · Sub-Agents — parent-mediated worker, 8 steps</option>
        <option value="/events">12 · Bookings Events — availability notification, 6 steps</option>
        <option value="/wallet-protocol">13 · Wallet Protocol — decisions and recovery, 3 scenarios</option>
        <option value="/documents">14 · Document Release — resource permission first, 4 steps</option>
        <option value="/catalog-gateway">15 · Travel Catalog — service-qualified access, 5 steps</option>
    </select>
</label>

@code {
    [Parameter, EditorRequired]
    public string Value { get; set; } = "Bootstrap";

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<TourMode> ModeChanged { get; set; }

    private async Task OnChanged(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }
        if (value.StartsWith("/", StringComparison.Ordinal))
        {
            Navigation.NavigateTo(value);
            return;
        }
        if (!Enum.TryParse<TourMode>(value, out var mode))
        {
            return;
        }
        if (ModeChanged.HasDelegate)
        {
            await ModeChanged.InvokeAsync(mode);
        }
        else
        {
            Navigation.NavigateTo($"/tour?flow={mode}");
        }
    }
}
