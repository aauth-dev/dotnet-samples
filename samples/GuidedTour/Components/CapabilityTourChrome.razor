@inject Microsoft.Extensions.Options.IOptions<TourOptions> Options

<header class="topbar">
    <a class="topbar__back" href="">← Overview</a>
    <h1>AAuth Guided Tour</h1>
    <div class="config">
        <span class="hl-resource"><strong>@ResourceLabel:</strong> @ResourceUrl</span>
        @if (ShowConcierge)
        {
            <span class="hl-resource"><strong>Concierge:</strong> @Options.Value.ConciergeUrl</span>
        }
        @if (ShowPersonServer)
        {
            <span class="hl-ps"><strong>Person Server:</strong> @Options.Value.PersonServerUrl</span>
        }
        @if (ShowAccessServer)
        {
            <span class="hl-as"><strong>Access Server:</strong> @Options.Value.AccessServerUrl</span>
        }
        @if (ShowR3AccessServer)
        {
            <span class="hl-as"><strong>R3 Access Server:</strong> @Options.Value.R3AccessServerUrl</span>
        }
        @if (ShowAgentProvider)
        {
            <span class="hl-agent"><strong>Agent Provider:</strong> @Options.Value.AgentProviderUrl</span>
        }
    </div>
</header>

<section class="flow-picker capability-flow-picker">
    <TourFlowSelect Value="@CurrentValue" />
</section>

@code {
    [Parameter, EditorRequired] public string CurrentValue { get; set; } = "";
    [Parameter, EditorRequired] public string ResourceLabel { get; set; } = "Resource";
    [Parameter, EditorRequired] public string ResourceUrl { get; set; } = "";
    [Parameter] public bool ShowAgentProvider { get; set; } = true;
    [Parameter] public bool ShowPersonServer { get; set; } = true;
    [Parameter] public bool ShowAccessServer { get; set; }
    [Parameter] public bool ShowR3AccessServer { get; set; }
    [Parameter] public bool ShowConcierge { get; set; }
}
