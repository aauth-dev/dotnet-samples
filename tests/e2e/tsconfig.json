{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "baseUrl": ".",
    "paths": {
      "@playwright/test": ["node_modules/@playwright/test"]
    },
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "*.ts",
    "helpers/**/*.ts",
    "../../samples/GuidedTour/playwright-tests/**/*.ts",
    "../../samples/SampleApp/playwright-tests/**/*.ts"
  ]
}
