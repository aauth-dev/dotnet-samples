<Project Sdk="Microsoft.NET.Sdk">

  <!-- Common settings and packages come from tests/Directory.Build.props. -->

  <ItemGroup>
    <ProjectReference Include="..\..\src\AAuth\AAuth.csproj" />
    <ProjectReference Include="..\..\samples\MockResourceServers\Calendar\Calendar.csproj" />
    <ProjectReference Include="..\..\samples\MockResourceServers\Inbox\Inbox.csproj" />
    <ProjectReference Include="..\..\samples\MockPersonServer\MockPersonServer.csproj" />
    <ProjectReference Include="..\..\samples\MockAccessServers\Federated\Federated.csproj" />
    <ProjectReference Include="../../samples/MockAccessServers/R3/R3.csproj" />
    <ProjectReference Include="..\..\samples\GuidedTour\GuidedTour.csproj" />
    <ProjectReference Include="..\..\samples\SampleApp\SampleApp.csproj" />
    <ProjectReference Include="../../samples/Concierge/Concierge.csproj" />
    <ProjectReference Include="../../samples/MockAgentProvider/MockAgentProvider.csproj" />
    <ProjectReference Include="../../samples/LiveWhoAmITest/LiveWhoAmITest.csproj" />
  </ItemGroup>

  <!--
    Integration tests spin up the Calendar sample (and an in-process mock
    Person Server) via WebApplicationFactory<T>. The MVC test host package
    surfaces WebApplicationFactory, TestServer, and the associated handler
    that lets the agent HttpClient talk to the test server without a real
    network hop.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.dll" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll" />
  </ItemGroup>

</Project>